+    # ------------------------------------------------------------------ #
+    # Layer-pruning mask API                                              #
+    # ------------------------------------------------------------------ #
+
+    def set_layer_mask(self, drop_video=(), drop_action=()) -> None:
+        """Mark layers as identity passthrough. Indices are in [0, num_layers)."""
+        n = self.num_layers
+        keep_video = [True] * n
+        keep_action = [True] * n
+        for i in drop_video:
+            if not 0 <= int(i) < n:
+                raise ValueError(f"drop_video index {i} out of range [0,{n}).")
+            keep_video[int(i)] = False
+        for i in drop_action:
+            if not 0 <= int(i) < n:
+                raise ValueError(f"drop_action index {i} out of range [0,{n}).")
+            keep_action[int(i)] = False
+        self.keep_video = keep_video
+        self.keep_action = keep_action
+        logger.info(
+            "[MoT prune] drop_video=%s drop_action=%s -> kept video=%d/%d action=%d/%d",
+            sorted(int(i) for i in drop_video),
+            sorted(int(i) for i in drop_action),
+            sum(keep_video), n, sum(keep_action), n,
+        )
+
+    def reset_layer_mask(self) -> None:
+        self.keep_video = [True] * self.num_layers
+        self.keep_action = [True] * self.num_layers
+
+    @property
+    def pruned_layers(self) -> dict:
+        return {
+            "drop_video": [i for i, k in enumerate(self.keep_video) if not k],
+            "drop_action": [i for i, k in enumerate(self.keep_action) if not k],
+        }
 
