+        if not os.path.exists(ckpt_path):
+            candidates = sorted(glob.glob(os.path.join(pretrained_path, f"{module_name}--*_checkpoint.pt")))
+            ckpt_path = candidates[-1] if candidates else None
+        if ckpt_path is not None and os.path.exists(ckpt_path):
+            state_dict = load_checkpoint_by_path(ckpt_path)
+            module.load_state_dict(state_dict)
+            print(f"Loaded pretrained {module_name} from {ckpt_path}")
+        else:
+            print(f"WARNING: No pretrained checkpoint for {module_name} in {pretrained_path}, using random init")
+
+    if to_bf16:
+        module = module.to(torch.bfloat16)
+    module = module.to(device_id)
+
+    return wrap_ddp(module, device_id, find_unused_params)
