+    teacher_proprio_projector = None
+    if cfg.use_proprio:
+        teacher_proprio_projector = ProprioProjector(
+            llm_dim=teacher_vla.llm_dim, proprio_dim=PROPRIO_DIM
+        ).to(device)
+        candidates = sorted(Path(teacher_path).glob("proprio_projector--*_checkpoint.pt"))
+        if len(candidates) != 1:
+            raise ValueError("Teacher requires exactly one unambiguous proprio_projector checkpoint")
+        teacher_proprio_projector.load_state_dict(load_checkpoint_by_path(str(candidates[0])))
+        for p in teacher_proprio_projector.parameters():
+            p.requires_grad = False
+        teacher_proprio_projector.eval()
+
+    # === Compute NUM_PATCHES ===
+    NUM_PATCHES = teacher_vla.vision_backbone.get_num_patches() * teacher_vla.vision_backbone.get_num_images_in_input()
+    if cfg.use_proprio:
+        NUM_PATCHES += 1
+
+    # === Load Dataset (with image_aug) ===
+    action_tokenizer = ActionTokenizer(processor.tokenizer)
+    use_wrist_image = cfg.num_images_in_input > 1
+    batch_transform = RLDSBatchTransform(
+        action_tokenizer,
