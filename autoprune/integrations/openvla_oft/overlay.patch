+"""
+finetune_phase2_adapter.py
+
+Phase-2 distillation that REPLACES LoRA with tiny replacement adapters
+(LLM-Streamline-lite) inserted at each removed-segment boundary. Only the
+adapters (and action_head / proprio_projector if loaded fresh) are trainable;
+the base 32-layer-pruned LLaMA backbone is frozen.
+
+Adapters: 4096 → 1024 → 4096 residual MLP, zero-init up_proj so initial
+behavior is identity (= no-recovery student).
+
+Output: <run_dir>/adapter--<step>_checkpoint.pt with the boundary adapters'
+state_dict; the base model is NOT re-saved (eval scripts re-apply mask + load
+adapters at inference).
+
+Run:
+    CUDA_VISIBLE_DEVICES=4,5,6,7 torchrun --standalone --nnodes 1 --nproc_per_node 4 \\
+        vla-scripts/finetune_phase2_adapter.py \\
+        --vla_path /path/to/openvla-7b-oft-finetuned-libero-object \\
+        --data_root_dir /path/to/modified_libero_rlds \\
+        --dataset_name libero_object_no_noops \\
+        --teacher_cache_dir <CACHE>/libero_object_no_noops \\
+        --remove_layers "2,3,5,6,11,14,17,21,23,25,27,28" \\
+        --run_id_note adapter_k12_<TS>
+"""
+
+import os
+import sys
+import time
+from collections import deque
+from dataclasses import dataclass
+from pathlib import Path
+from typing import List, Optional
+
+import draccus
+import torch
+import torch.distributed as dist
+from accelerate import PartialState
+from huggingface_hub import snapshot_download
+from torch.optim import AdamW
+from torch.optim.lr_scheduler import MultiStepLR
+from torch.utils.data import DataLoader
+from transformers import AutoConfig, AutoImageProcessor, AutoModelForVision2Seq, AutoProcessor
+
+import wandb
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from experiments.robot.openvla_utils import (
+    check_model_logic_mismatch,
+    model_is_on_hf_hub,
+    update_auto_map,
+)
+from prismatic.extern.hf.configuration_prismatic import OpenVLAConfig
+from prismatic.extern.hf.modeling_prismatic_layerprune import GatedOpenVLAForActionPrediction
+from prismatic.extern.hf.processing_prismatic import PrismaticImageProcessor, PrismaticProcessor
+from prismatic.models.action_heads import L1RegressionActionHead
+from prismatic.models.backbones.llm.prompting import PurePromptBuilder
+from prismatic.models.projectors import ProprioProjector
+from prismatic.training.replacement_adapter import (
+    install_adapters,
+    adapter_parameters,
+    save_adapters,
+)
+from prismatic.training.teacher_cache import TeacherOutputCache
+from prismatic.util.data_utils import PaddedCollatorForActionPrediction
+from prismatic.vla.action_tokenizer import ActionTokenizer
+from prismatic.vla.constants import (
+    ACTION_DIM,
+    ACTION_PROPRIO_NORMALIZATION_TYPE,
+    NUM_ACTIONS_CHUNK,
+    PROPRIO_DIM,
+)
+from prismatic.vla.datasets import RLDSBatchTransform, RLDSDataset
+from prismatic.vla.datasets.rlds.utils.data_utils import save_dataset_statistics
+
+from finetune_phase2_only import apply_layer_mask, parse_mask
+from finetune_layer_pruning_cached import (
+    compute_smoothened_metrics,
+    init_module,
+    log_metrics_to_wandb,
+    run_phase2_forward_pass,
+    wrap_ddp,
+)
+
+os.environ["TOKENIZERS_PARALLELISM"] = "false"
+
+
+@dataclass
+class Phase2AdapterConfig:
+    seed: int = 7
+    remove_layers: str = ""
+
+    vla_path: str = "openvla/openvla-7b"
+    data_root_dir: Path = Path("datasets/rlds")
+    dataset_name: str = "libero_object_no_noops"
+    teacher_cache_dir: Optional[str] = None
+    run_root_dir: Path = Path("runs")
+    run_id_note: str = ""
+
+    use_l1_regression: bool = True
+    use_diffusion: bool = False
+    use_film: bool = False
+    use_proprio: bool = True
+    num_images_in_input: int = 2
+    num_diffusion_steps_train: int = 50
+
+    batch_size: int = 4
+    learning_rate: float = 1e-3      # higher than LoRA — only adapters train
+    lr_warmup_steps: int = 0
+    num_steps_before_decay: int = 8000
+    grad_accumulation_steps: int = 1
+    max_steps: int = 10_000
+    save_freq: int = 5_000
+    image_aug: bool = True
+    shuffle_buffer_size: int = 100_000
+
+    adapter_bottleneck: int = 1024
+    adapter_type: str = "mlp"  # one of: mlp, resmlp2, resmlp3, transformer
+
+    action_loss_weight: float = 1.0
+    kl_loss_weight: float = 1.0
+
+    freeze_sidecars: bool = False  # if True, freeze action_head + proprio_projector — train ONLY adapter
+
+    resume: bool = False
+    resume_step: Optional[int] = None
+
+    wandb_entity: str = "autoprune"
+    wandb_project: str = "autoprune"
+    wandb_log_freq: int = 10
+
+
+def get_run_id(cfg: Phase2AdapterConfig, removed: List[int]) -> str:
+    base = cfg.vla_path.rstrip("/").split("/")[-1]
+    rm_str = "-".join(str(i) for i in removed)
+    parts = [
+        f"{base}+{cfg.dataset_name}",
+        f"phase2adapter+rm[{rm_str}]",
+        f"steps{cfg.max_steps}+kl{cfg.kl_loss_weight}+act{cfg.action_loss_weight}",
+        f"bn{cfg.adapter_bottleneck}",
+    ]
+    if cfg.adapter_type != "mlp":
+        parts.append(f"adapter_{cfg.adapter_type}")
+    if cfg.image_aug:
+        parts.append("image_aug")
+    if cfg.run_id_note:
+        parts.append(cfg.run_id_note)
+    return "--".join(parts)
+
+
+@draccus.wrap()
+def main(cfg: Phase2AdapterConfig) -> None:
+    import random
+    import numpy as np
+    import tensorflow as tf
+    random.seed(cfg.seed)
+    np.random.seed(cfg.seed)
+    torch.manual_seed(cfg.seed)
+    tf.random.set_seed(cfg.seed)
+    assert cfg.teacher_cache_dir is not None, "Need --teacher_cache_dir."
+    assert not (cfg.use_l1_regression and cfg.use_diffusion)
+    cfg.vla_path = cfg.vla_path.rstrip("/")
+
+    remove_indices = parse_mask(cfg.remove_layers)
+    run_id = get_run_id(cfg, remove_indices)
+    run_dir = cfg.run_root_dir / run_id
+    os.makedirs(run_dir, exist_ok=True)
+
+    distributed_state = PartialState()
+    device_id = distributed_state.local_process_index
+    torch.cuda.set_device(device_id)
+    torch.cuda.empty_cache()
+
+    if distributed_state.is_main_process:
+        wandb.init(entity=cfg.wandb_entity, project=cfg.wandb_project,
+                   name=f"phase2adapter+{run_id}")
+        print(f"[adapter] removing {remove_indices} ({len(remove_indices)}/32)")
+        print(f"[adapter] run_dir: {run_dir}")
+
+    # === Load base ===
+    if model_is_on_hf_hub(cfg.vla_path):
+        cfg.vla_path = snapshot_download(repo_id=cfg.vla_path)
+    else:
+        AutoConfig.register("openvla", OpenVLAConfig, exist_ok=True)
+        AutoImageProcessor.register(OpenVLAConfig, PrismaticImageProcessor, exist_ok=True)
+        AutoProcessor.register(OpenVLAConfig, PrismaticProcessor, exist_ok=True)
+        AutoModelForVision2Seq.register(OpenVLAConfig, GatedOpenVLAForActionPrediction, exist_ok=True)
+
+    if distributed_state.is_main_process:
+        update_auto_map(cfg.vla_path)
+        check_model_logic_mismatch(cfg.vla_path)
+    dist.barrier()
+
+    processor = AutoProcessor.from_pretrained(cfg.vla_path, trust_remote_code=True)
+    vla = GatedOpenVLAForActionPrediction.from_pretrained(
+        cfg.vla_path, torch_dtype=torch.bfloat16, low_cpu_mem_usage=True,
+    ).to(device_id)
+    vla.vision_backbone.set_num_images_in_input(cfg.num_images_in_input)
+
+    # === Apply mask ===
+    result = apply_layer_mask(vla, remove_indices)
+    if distributed_state.is_main_process:
+        print(f"[adapter] kept {len(result['kept_layers'])}: {result['kept_layers']}")
+        wandb.log({
+            "Pruning/Num Kept Layers": len(result["kept_layers"]),
+            "Pruning/Num Removed Layers": len(result["removed_layers"]),
+        }, step=0)
+
+    # === Install adapters ===
+    hidden_size = vla.config.text_config.hidden_size
+    adapters = install_adapters(
+        vla, remove_indices,
+        hidden_size=hidden_size,
+        bottleneck=cfg.adapter_bottleneck,
+        total_layers=32,
+        dtype=torch.bfloat16,
+        adapter_type=cfg.adapter_type,
+    )
+    adapters_to_device = [a.to(device_id) for a in adapters.values()]
+    if distributed_state.is_main_process:
+        print(f"[adapter] installed {len(adapters)} adapters at student layers {sorted(adapters.keys())}")
+
+    # === Freeze everything except adapters ===
+    for p in vla.parameters():
+        p.requires_grad_(False)
+    for a in adapters.values():
+        for p in a.parameters():
+            p.requires_grad_(True)
+
+    # === Teacher cache ===
+    teacher_cache = TeacherOutputCache(cfg.teacher_cache_dir)
+    if distributed_state.is_main_process:
+        print(f"[adapter] teacher cache: {len(teacher_cache)} samples")
+    AutoModelForVision2Seq.register(OpenVLAConfig, GatedOpenVLAForActionPrediction, exist_ok=True)
+
+    # === DDP wrap ===
+    vla = wrap_ddp(vla, device_id, find_unused=True)
+
+    # === Sidecars ===
+    proprio_projector = None
+    if cfg.use_proprio:
+        proprio_projector = init_module(
+            ProprioProjector, "proprio_projector", cfg, device_id,
+            {"llm_dim": vla.module.llm_dim, "proprio_dim": PROPRIO_DIM},
+            pretrained_path=cfg.vla_path,
+        )
+
+    action_head = None
+    if cfg.use_l1_regression:
+        action_head = init_module(
+            L1RegressionActionHead, "action_head", cfg, device_id,
+            {"input_dim": vla.module.llm_dim, "hidden_dim": vla.module.llm_dim,
+             "action_dim": ACTION_DIM},
+            to_bf16=True,
+            pretrained_path=cfg.vla_path,
+        )
+
+    # === Optionally freeze sidecars (adapter-only ablation) ===
+    if cfg.freeze_sidecars:
+        if action_head is not None:
+            for p in action_head.parameters(): p.requires_grad_(False)
+        if proprio_projector is not None:
+            for p in proprio_projector.parameters(): p.requires_grad_(False)
+        if distributed_state.is_main_process:
+            print("[adapter] FROZEN sidecars (action_head + proprio_projector); training adapter only")
+
+    # === Optimizer (only adapter params; sidecars stay trainable as in phase2-only) ===
+    trainable_params = list(adapter_parameters(adapters))
+    if action_head is not None:
+        trainable_params += [p for p in action_head.parameters() if p.requires_grad]
+    if proprio_projector is not None:
+        trainable_params += [p for p in proprio_projector.parameters() if p.requires_grad]
+
+    if distributed_state.is_main_process:
+        n_adapter = sum(p.numel() for p in adapter_parameters(adapters))
+        n_total = sum(p.numel() for p in trainable_params)
+        print(f"[adapter] trainable params: adapter={n_adapter:,}  total={n_total:,}")
+
+    optimizer = AdamW(trainable_params, lr=cfg.learning_rate)
+    original_lr = optimizer.param_groups[0]["lr"]
+    scheduler = MultiStepLR(optimizer, milestones=[cfg.num_steps_before_decay], gamma=0.1)
+
+    # === Dataset ===
+    action_tokenizer = ActionTokenizer(processor.tokenizer)
+    use_wrist_image = cfg.num_images_in_input > 1
+    batch_transform = RLDSBatchTransform(
+        action_tokenizer, processor.tokenizer,
+        image_transform=processor.image_processor.apply_transform,
+        prompt_builder_fn=PurePromptBuilder,
+        use_wrist_image=use_wrist_image, use_proprio=cfg.use_proprio,
+    )
+    train_dataset = RLDSDataset(
+        cfg.data_root_dir, cfg.dataset_name, batch_transform,
+        resize_resolution=tuple(vla.module.config.image_sizes),
+        shuffle_buffer_size=cfg.shuffle_buffer_size, image_aug=cfg.image_aug,
+    )
+    if distributed_state.is_main_process:
+        save_dataset_statistics(train_dataset.dataset_statistics, run_dir)
+    collator = PaddedCollatorForActionPrediction(
+        processor.tokenizer.model_max_length,
+        processor.tokenizer.pad_token_id, padding_side="right",
+    )
+    dataloader = DataLoader(
+        train_dataset, batch_size=cfg.batch_size, sampler=None,
+        collate_fn=collator, num_workers=0,
+    )
+
+    cache_num_patches = teacher_cache.metadata.get("num_patches")
+    if cache_num_patches is not None:
+        NUM_PATCHES = int(cache_num_patches)
+    else:
+        NUM_PATCHES = (
+            vla.module.vision_backbone.get_num_patches()
+            * vla.module.vision_backbone.get_num_images_in_input() + 1
+        )
+    if distributed_state.is_main_process:
+        print(f"[adapter] NUM_PATCHES = {NUM_PATCHES}")
+
+    recent_metrics = {
+        "loss_value": deque(maxlen=cfg.grad_accumulation_steps),
+        "action_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "kl_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "teacher_gt_loss": deque(maxlen=cfg.grad_accumulation_steps),
+    }
+
+    print(f"[adapter] starting Phase-2 adapter training for {cfg.max_steps} steps")
+    log_step = 0
+    t_start = time.time()
+
+    for batch_idx, batch in enumerate(dataloader):
+        loss, metrics = run_phase2_forward_pass(
+            vla=vla, teacher_vla=None, action_head=action_head,
+            teacher_action_head=None, noisy_action_projector=None,
+            proprio_projector=proprio_projector,
+            teacher_noisy_action_projector=None,
+            teacher_proprio_projector=None,
+            batch=batch, action_tokenizer=action_tokenizer,
+            device_id=device_id,
+            use_l1_regression=cfg.use_l1_regression,
+            use_diffusion=cfg.use_diffusion,
+            use_proprio=cfg.use_proprio, use_film=cfg.use_film,
+            num_patches=NUM_PATCHES, cfg=cfg, teacher_cache=teacher_cache,
+        )
+
+        normalized_loss = loss / cfg.grad_accumulation_steps
+        normalized_loss.backward()
+
+        for k, v in metrics.items():
+            if k in recent_metrics:
+                recent_metrics[k].append(v)
+        smoothened = compute_smoothened_metrics(recent_metrics)
+
+        if distributed_state.is_main_process and log_step % cfg.wandb_log_freq == 0:
+            log_metrics_to_wandb(smoothened, "VLA Train", log_step, wandb)
+            wandb.log({"VLA Train/Learning Rate": scheduler.get_last_lr()[0]}, step=log_step)
+
+        if (batch_idx + 1) % cfg.grad_accumulation_steps == 0:
+            optimizer.step()
+            scheduler.step()
+            optimizer.zero_grad()
+
+        # Save adapter
+        if distributed_state.is_main_process and log_step > 0 and log_step % cfg.save_freq == 0:
+            ap = run_dir / f"adapter--{log_step}_checkpoint.pt"
+            save_adapters(adapters, str(ap), meta={
+                "remove_layers": remove_indices,
+                "step": log_step,
+                "bottleneck": cfg.adapter_bottleneck,
+                "adapter_type": cfg.adapter_type,
+            })
+            print(f"[adapter] saved {ap}")
+
+        log_step += 1
+
+        if log_step % 100 == 0 and distributed_state.is_main_process:
+            elapsed = time.time() - t_start
+            sps = log_step / max(elapsed, 1e-6)
+            eta = (cfg.max_steps - log_step) / max(sps, 1e-6)
+            print(f"[adapter] step {log_step}/{cfg.max_steps}  "
+                  f"loss={smoothened.get('loss_value', float('nan')):.4f}  "
+                  f"act={smoothened.get('action_loss', float('nan')):.4f}  "
+                  f"kl={smoothened.get('kl_loss', float('nan')):.4f}  "
+                  f"({sps:.2f}/s, ETA {eta/60:.1f}min)")
+
+        if log_step >= cfg.max_steps:
+            break
+
+    if distributed_state.is_main_process:
+        ap = run_dir / f"adapter--{log_step}_checkpoint.pt"
+        save_adapters(adapters, str(ap), meta={
+            "remove_layers": remove_indices,
+            "step": log_step,
+            "bottleneck": cfg.adapter_bottleneck,
+            "adapter_type": cfg.adapter_type,
+        })
+        print(f"[adapter] saved final {ap}")
+
+        # Also save action_head and proprio_projector for eval
+        if action_head is not None:
+            ah_path = run_dir / f"action_head--{log_step}_checkpoint.pt"
+            torch.save(
+                action_head.module.state_dict() if hasattr(action_head, "module") else action_head.state_dict(),
+                str(ah_path),
+            )
+            print(f"[adapter] saved {ah_path}")
+        if proprio_projector is not None:
+            pp_path = run_dir / f"proprio_projector--{log_step}_checkpoint.pt"
+            torch.save(
+                proprio_projector.module.state_dict() if hasattr(proprio_projector, "module") else proprio_projector.state_dict(),
+                str(pp_path),
+            )
+            print(f"[adapter] saved {pp_path}")
+        # And mark dataset stats path for eval unnorm
+        save_dataset_statistics(train_dataset.dataset_statistics, run_dir)
+
+        # Symlink base model files so eval can use this dir as pretrained_checkpoint
+        base_dir = Path(cfg.vla_path)
+        link_files = [
+            "config.json", "configuration_prismatic.py", "modeling_prismatic.py",
+            "processing_prismatic.py", "preprocessor_config.json", "generation_config.json",
+            "model.safetensors.index.json", "processor_config.json",
+            "tokenizer.json", "tokenizer.model", "tokenizer_config.json",
+            "special_tokens_map.json", "added_tokens.json",
+        ]
+        for fname in link_files:
+            src = base_dir / fname
+            dst = run_dir / fname
+            if src.exists() and not dst.exists():
+                os.symlink(str(src), str(dst))
+        for src in base_dir.glob("model-*.safetensors"):
+            dst = run_dir / src.name
+            if not dst.exists():
+                os.symlink(str(src), str(dst))
+        print(f"[adapter] symlinked base model files from {base_dir}")
+
+    print(f"[adapter] DONE. wall-clock {(time.time() - t_start) / 60:.1f}min")
+
+
+if __name__ == "__main__":
+    main()
