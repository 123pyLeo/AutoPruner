diff --git a/phase1/training_signals.py b/phase1/training_signals.py
new file mode 100644
index 0000000..fdab488
--- /dev/null
+++ b/phase1/training_signals.py
@@ -0,0 +1,260 @@
+"""SignalRecorder: capture B-2 training-time signals.
+
+Inserted into vla-scripts/finetune_phase2_only.py via 4 hook calls. All hooks are
+no-op when SignalRecorder is None, so existing agent loop is unaffected.
+
+Signals recorded (one JSON line per logged step into <record_dir>/signals.jsonl):
+
+  | signal                  | source          | overhead | impl status |
+  |-------------------------|-----------------|----------|-------------|
+  | act_loss                | metrics dict    | none     | done        |
+  | kl_loss                 | metrics dict    | none     | done        |
+  | grad_norm               | model.parameters() post-backward | tiny | done |
+  | grad_norm_per_layer     | per-block grad scan | small | done       |
+  | act_per_task_var        | per-task split of batch act loss | small | done |
+  | block_influence (BI)    | hidden-state hooks per layer | medium | TODO |
+  | attention_entropy       | attention hooks per layer | medium | TODO |
+  | action_consistency      | fixed obs replay  | medium | TODO |
+  | partial_rollout_sr      | LIBERO env @ every rollout_freq steps | high | TODO |
+
+Hook contract (called from finetune_phase2_only.py):
+
+    rec = SignalRecorder(record_dir, log_freq=100, rollout_freq=1000) if cfg.signal_record_dir else None
+
+    rec and rec.on_step_pre_backward(step, batch, metrics)
+    loss.backward()
+    rec and rec.on_step_post_backward(step, model)
+    rec and rec.on_step_post_optim(step, model, optimizer)
+    if step % rollout_freq == 0:
+        rec and rec.on_partial_rollout(step, model, processor, action_head, ...)
+    rec and rec.close()
+"""
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+from typing import Any
+
+
+class SignalRecorder:
+    """Append-only JSONL signal recorder. Hot path = step hooks; minimize per-step work.
+
+    Buffers per-step metrics in self._row, flushes on flush_now() or every log_freq steps.
+    """
+
+    def __init__(
+        self,
+        record_dir: str | Path,
+        remove_list: list[int],
+        log_freq: int = 100,
+        rollout_freq: int = 1000,
+        rollout_n_episodes: int = 20,
+        rollout_max_steps: int = 50,
+        enable_bi: bool = False,
+        enable_attn_entropy: bool = False,
+        enable_action_consistency: bool = False,
+        enable_partial_rollout: bool = False,
+    ):
+        self.record_dir = Path(record_dir)
+        self.record_dir.mkdir(parents=True, exist_ok=True)
+        self.signals_path = self.record_dir / "signals.jsonl"
+        self.remove_list = sorted(set(int(x) for x in remove_list))
+        self.kept_layers = [i for i in range(32) if i not in set(self.remove_list)]
+        self.log_freq = log_freq
+        self.rollout_freq = rollout_freq
+        self.rollout_n_episodes = rollout_n_episodes
+        self.rollout_max_steps = rollout_max_steps
+        self.enable_bi = enable_bi
+        self.enable_attn_entropy = enable_attn_entropy
+        self.enable_action_consistency = enable_action_consistency
+        self.enable_partial_rollout = enable_partial_rollout
+        # Per-step accumulator (cleared on flush)
+        self._row: dict[str, Any] = {}
+        # Hooks installed lazily on first call
+        self._hooks_installed = False
+        self._bi_inputs: dict[int, "torch.Tensor"] = {}    # layer_idx -> hidden_in
+        self._bi_outputs: dict[int, "torch.Tensor"] = {}   # layer_idx -> hidden_out
+        self._attn_entropies: dict[int, float] = {}
+        # Manifest
+        manifest = {
+            "ts_init": time.time(),
+            "remove_list": self.remove_list,
+            "kept_layers": self.kept_layers,
+            "log_freq": log_freq,
+            "rollout_freq": rollout_freq,
+            "rollout_n_episodes": rollout_n_episodes,
+            "rollout_max_steps": rollout_max_steps,
+            "enabled": {
+                "bi": enable_bi,
+                "attn_entropy": enable_attn_entropy,
+                "action_consistency": enable_action_consistency,
+                "partial_rollout": enable_partial_rollout,
+            },
+        }
+        (self.record_dir / "manifest.json").write_text(
+            json.dumps(manifest, indent=2)
+        )
+
+    # ---------------- Step hooks (called from training loop) ----------------
+
+    def on_step_pre_backward(self, step: int, batch: dict, metrics: dict) -> None:
+        """Capture cheap per-batch info before .backward(). Includes per-task act variance."""
+        if step % self.log_freq != 0:
+            return
+        self._row = {
+            "step": int(step),
+            "ts": time.time(),
+            "act_loss": float(metrics.get("action_loss", float("nan"))),
+            "kl_loss": float(metrics.get("kl_loss", float("nan"))),
+        }
+        # act_per_task_var: requires the forward pass to compute per-sample act loss
+        # AND batch to carry task ids. If neither present, skip.
+        per_sample_act = metrics.get("action_loss_per_sample")
+        task_ids = batch.get("task_ids") if isinstance(batch, dict) else None
+        if per_sample_act is not None and task_ids is not None:
+            self._row["act_per_task_var"] = _per_task_variance(per_sample_act, task_ids)
+        else:
+            self._row["act_per_task_var"] = None
+
+    def on_step_post_backward(self, step: int, model) -> None:
+        """Capture grad-norm metrics after .backward(), before optimizer.step().
+
+        Important: .backward() has already been called; grads exist on parameters.
+        optimizer.step() will mutate weights, so this is the right window.
+        """
+        if step % self.log_freq != 0 or not self._row:
+            return
+        try:
+            import torch
+        except ImportError:
+            return
+        # Global grad norm
+        total_sq = 0.0
+        n_params = 0
+        for p in model.parameters():
+            if p.grad is not None:
+                total_sq += float(p.grad.detach().pow(2).sum().item())
+                n_params += 1
+        self._row["grad_norm"] = total_sq ** 0.5 if n_params else None
+        # Per-layer grad norm: scan named params, group by layer index in name
+        per_layer = {}
+        for name, p in model.named_parameters():
+            if p.grad is None:
+                continue
+            layer_idx = _extract_layer_idx(name)
+            if layer_idx is None:
+                continue
+            per_layer.setdefault(layer_idx, 0.0)
+            per_layer[layer_idx] += float(p.grad.detach().pow(2).sum().item())
+        self._row["grad_norm_per_layer"] = {
+            str(li): v ** 0.5 for li, v in sorted(per_layer.items())
+        }
+
+    def on_step_post_optim(self, step: int, model, optimizer) -> None:
+        """Optional: capture post-optim signals (BI, attention entropy if hooks fired)."""
+        if step % self.log_freq != 0 or not self._row:
+            return
+        # BI from cached hook outputs (TODO: implement hook installation)
+        if self.enable_bi and self._bi_inputs and self._bi_outputs:
+            try:
+                import torch
+                bi_per_layer = {}
+                for li in self._bi_inputs:
+                    if li not in self._bi_outputs:
+                        continue
+                    h_in = self._bi_inputs[li].detach().float()
+                    h_out = self._bi_outputs[li].detach().float()
+                    # cosine distance: 1 - cos(h_in, h_out), avg across batch & seq
+                    cos = torch.nn.functional.cosine_similarity(
+                        h_in.flatten(0, -2), h_out.flatten(0, -2), dim=-1
+                    ).mean().item()
+                    bi_per_layer[str(li)] = float(1.0 - cos)
+                self._row["block_influence_per_layer"] = bi_per_layer
+            except Exception:
+                self._row["block_influence_per_layer"] = None
+            self._bi_inputs.clear()
+            self._bi_outputs.clear()
+        if self.enable_attn_entropy and self._attn_entropies:
+            self._row["attention_entropy_per_layer"] = {
+                str(li): float(e) for li, e in sorted(self._attn_entropies.items())
+            }
+            self._attn_entropies.clear()
+        # Flush this step
+        self._flush_row()
+
+    def on_partial_rollout(self, step: int, model, processor, action_head, env_factory,
+                           **kwargs) -> dict | None:
+        """Run short LIBERO rollout, append rollout_sr signal. Returns dict or None.
+
+        env_factory: callable () -> libero env. Caller provides because we don't want
+        this module to import LIBERO directly.
+
+        TODO: real implementation. Currently records None as placeholder.
+        """
+        if not self.enable_partial_rollout:
+            return None
+        if step % self.rollout_freq != 0:
+            return None
+        # TODO: actual rollout. Stub: log placeholder for now.
+        rollout_record = {
+            "step": int(step),
+            "ts": time.time(),
+            "n_episodes": self.rollout_n_episodes,
+            "max_steps_per_ep": self.rollout_max_steps,
+            "rollout_sr": None,            # TODO real value
+            "per_task_sr": None,           # TODO
+            "stub": True,
+        }
+        rollout_path = self.record_dir / "rollouts.jsonl"
+        with open(rollout_path, "a") as f:
+            f.write(json.dumps(rollout_record) + "\n")
+        return rollout_record
+
+    # ---------------- Internals ----------------
+
+    def _flush_row(self) -> None:
+        if not self._row:
+            return
+        with open(self.signals_path, "a") as f:
+            f.write(json.dumps(self._row, ensure_ascii=False) + "\n")
+        self._row = {}
+
+    def close(self) -> None:
+        self._flush_row()
+
+
+# ---------------- Helpers ----------------
+
+def _extract_layer_idx(param_name: str) -> int | None:
+    """From a parameter name like 'language_model.model.layers.17.self_attn.q_proj.weight',
+    extract 17. Returns None if no layer index found.
+    """
+    parts = param_name.split(".")
+    for i, tok in enumerate(parts):
+        if tok == "layers" and i + 1 < len(parts):
+            try:
+                return int(parts[i + 1])
+            except ValueError:
+                return None
+    return None
+
+
+def _per_task_variance(per_sample_loss: list[float] | "torch.Tensor",
+                        task_ids: list[int] | "torch.Tensor") -> float | None:
+    """Variance of per-task mean act loss within one batch."""
+    try:
+        import numpy as np
+        losses = list(per_sample_loss) if not hasattr(per_sample_loss, "tolist") else per_sample_loss.tolist()
+        tids   = list(task_ids)        if not hasattr(task_ids, "tolist")        else task_ids.tolist()
+        if len(losses) != len(tids) or not losses:
+            return None
+        by_task: dict[int, list[float]] = {}
+        for l, t in zip(losses, tids):
+            by_task.setdefault(int(t), []).append(float(l))
+        means = [sum(v) / len(v) for v in by_task.values()]
+        if len(means) < 2:
+            return 0.0
+        return float(np.var(means))
+    except Exception:
+        return None
