+            print(f"Loaded teacher {module_name} from {ckpt_path}")
+        else:
+            print(f"WARNING: No teacher checkpoint for {module_name} in {teacher_path}, using random init")
+    if to_bf16:
+        module = module.to(torch.bfloat16)
+    module = module.to(device_id)
