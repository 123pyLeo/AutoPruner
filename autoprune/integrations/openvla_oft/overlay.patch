+"""
+finetune_phase2_only.py
+
+Run *only* the Phase 2 distillation fine-tune for a pre-specified layer-removal
+mask. Skips Phase 1 (no Gumbel gating, no learned mask). The intended use is
+the "C / T / S / R" mask comparison — to test whether the layer-removal
+candidate set chosen by ranking heuristics actually trains as well as the
+LLM tail-pruning baseline (Mask T) when both are given the same Phase-2 budget.
+
+Reuses helpers from finetune_layer_pruning_cached.py (init_module, wrap_ddp,
+run_phase2_forward_pass, log_metrics_to_wandb, save_training_checkpoint).
+
+Run on 2 GPUs (4, 5) via tmux:
+    CUDA_VISIBLE_DEVICES=4,5 torchrun --standalone --nnodes 1 --nproc_per_node 2 \
+        vla-scripts/finetune_phase2_only.py \
+        --vla_path  ${CKPT_ROOT}/openvla-7b-oft-finetuned-libero-object \
+        --data_root_dir ${DATA_ROOT} --dataset_name libero_object_no_noops \
+        --teacher_cache_dir ${CACHE_ROOT}/libero_object_no_noops \
+        --remove_layers "2,3,4,5,6,7,23,28" \
+        --run_id_note maskC_${TIMESTAMP}
+"""
+
+import glob
+import os
+import sys
+import time
+from collections import deque
+from dataclasses import dataclass
+from pathlib import Path
+from typing import List, Optional
+
+import draccus
+import torch
+import torch.distributed as dist
+import torch.nn as nn
+from accelerate import PartialState
+from huggingface_hub import snapshot_download
+from peft import LoraConfig, get_peft_model
+from torch.optim import AdamW
+from torch.optim.lr_scheduler import MultiStepLR
+from torch.utils.data import DataLoader
+from transformers import AutoConfig, AutoImageProcessor, AutoModelForVision2Seq, AutoProcessor
+
+import wandb
+
+# Resolve sibling vla-script imports (we live in vla-scripts/).
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from experiments.robot.openvla_utils import (
+    check_model_logic_mismatch,
+    model_is_on_hf_hub,
+    update_auto_map,
+)
+from prismatic.extern.hf.configuration_prismatic import OpenVLAConfig
+from prismatic.extern.hf.modeling_prismatic_layerprune import GatedOpenVLAForActionPrediction
+from prismatic.extern.hf.processing_prismatic import PrismaticImageProcessor, PrismaticProcessor
+from prismatic.models.action_heads import L1RegressionActionHead
+from prismatic.models.backbones.llm.prompting import PurePromptBuilder
+from prismatic.models.projectors import ProprioProjector
+from prismatic.training.teacher_cache import TeacherOutputCache
+from prismatic.util.data_utils import PaddedCollatorForActionPrediction
+from prismatic.vla.action_tokenizer import ActionTokenizer
+from prismatic.vla.constants import (
+    ACTION_DIM,
+    ACTION_PROPRIO_NORMALIZATION_TYPE,
+    NUM_ACTIONS_CHUNK,
+    PROPRIO_DIM,
+)
+from prismatic.vla.datasets import RLDSBatchTransform, RLDSDataset
+from prismatic.vla.datasets.rlds.utils.data_utils import save_dataset_statistics
+
+from finetune_layer_pruning_cached import (
+    compute_smoothened_metrics,
+    count_parameters,
+    init_module,
+    log_metrics_to_wandb,
+    run_phase2_forward_pass,
+    save_training_checkpoint,
+    wrap_ddp,
+)
+
+
+os.environ["TOKENIZERS_PARALLELISM"] = "false"
+
+
+# ----------------------------------------------------------------------------
+# Config
+# ----------------------------------------------------------------------------
+
+@dataclass
+class Phase2OnlyConfig:
+    """Subset of FinetuneConfig sufficient for Phase 2-only distillation."""
+
+    # Required: comma-separated layer indices to physically remove.
+    remove_layers: str = ""
+
+    # Paths
+    vla_path: str = "openvla/openvla-7b"
+    data_root_dir: Path = Path("datasets/rlds")
+    dataset_name: str = "libero_object_no_noops"
+    teacher_cache_dir: Optional[str] = None
+    run_root_dir: Path = Path("runs")
+    run_id_note: str = ""
+
+    # Algorithm switches (kept for run_phase2_forward_pass compatibility)
+    use_l1_regression: bool = True
+    use_diffusion: bool = False
+    use_film: bool = False
+    use_proprio: bool = True
+    num_images_in_input: int = 2
+    num_diffusion_steps_train: int = 50      # unused (use_diffusion=False)
+
+    # Training
+    batch_size: int = 4
+    learning_rate: float = 5e-4
+    lr_warmup_steps: int = 0
+    num_steps_before_decay: int = 8000        # decay LR by 10× near the end
+    grad_accumulation_steps: int = 1
+    max_steps: int = 10_000                   # Phase 2-only budget
+    save_freq: int = 5_000
+    save_latest_checkpoint_only: bool = False
+    image_aug: bool = True
+    shuffle_buffer_size: int = 100_000
+
+    # LoRA
+    use_lora: bool = True
+    lora_rank: int = 32
+    lora_alpha: Optional[int] = None  # None -> min(lora_rank, 16) (legacy default)
+    lora_dropout: float = 0.0
+    merge_lora_during_training: bool = True
+
+    # Loss weights
+    action_loss_weight: float = 1.0
+    kl_loss_weight: float = 1.0
+
+    # Resume controls (delegate to init_module's logic)
+    resume: bool = False
+    resume_step: Optional[int] = None
+
+    # Logging
+    wandb_entity: str = "yikengchen04-shenzhen-university"
+    wandb_project: str = "nanovla"
+    wandb_log_freq: int = 10
+
+    # B-2 signal recording (no-op if signal_record_dir is empty)
+    signal_record_dir: str = ""             # if non-empty, write signals.jsonl here
+    signal_log_freq: int = 100              # how often to dump a signal row
+    signal_rollout_freq: int = 1000         # partial_rollout_sr cadence
+    signal_enable_bi: bool = False          # block_influence (TODO: hooks)
+    signal_enable_attn_entropy: bool = False
+    signal_enable_action_consistency: bool = False
+    signal_enable_partial_rollout: bool = False  # requires LIBERO env hookup
+
+
+# ----------------------------------------------------------------------------
+# Mask application
+# ----------------------------------------------------------------------------
+
+def parse_mask(mask_str: str) -> List[int]:
+    """'2,3,4,5,6,7,23,28' -> [2,3,4,5,6,7,23,28]."""
+    if not mask_str.strip():
+        raise ValueError("--remove_layers cannot be empty for Phase 2-only.")
+    return sorted({int(s) for s in mask_str.split(",") if s.strip()})
+
+
+def apply_layer_mask(model, remove_indices: List[int]) -> dict:
+    """
+    Physically remove the listed decoder layers. Mirrors strip_pruned_layers
+    but takes an explicit removal set instead of a probability vector.
+
+    Works on both raw GatedOpenVLAForActionPrediction (HF model) and
+    PEFT-wrapped variants. We detect PEFT via class, not via `hasattr`,
+    because HF's PreTrainedModel exposes a `base_model` attribute too.
+
+    Returns: {"kept_layers": [...], "removed_layers": [...]}
+    """
+    from peft import PeftModel  # local import keeps top-level imports light
+    if isinstance(model, PeftModel):
+        inner_model = model.base_model.model
+    else:
+        inner_model = model
+    llama_model = inner_model.language_model.model
+
+    L = len(llama_model.layers)
+    remove_set = set(remove_indices)
+    bad = [i for i in remove_set if not (0 <= i < L)]
+    if bad:
+        raise IndexError(f"Layer indices out of range [0, {L}): {bad}")
+
+    kept = [i for i in range(L) if i not in remove_set]
+    llama_model.layers = nn.ModuleList([llama_model.layers[i] for i in kept])
+    for new_idx, layer in enumerate(llama_model.layers):
+        layer.self_attn.layer_idx = new_idx
+
+    llama_model.config.num_hidden_layers = len(kept)
+    inner_model.config.text_config.num_hidden_layers = len(kept)
+    return {"kept_layers": kept, "removed_layers": sorted(remove_set)}
+
+
+def get_run_id(cfg: Phase2OnlyConfig, removed: List[int]) -> str:
+    base = cfg.vla_path.rstrip("/").split("/")[-1]
+    rm_str = "-".join(str(i) for i in removed)
+    parts = [
+        f"{base}+{cfg.dataset_name}",
+        f"phase2only+rm[{rm_str}]",
+        f"steps{cfg.max_steps}+kl{cfg.kl_loss_weight}+act{cfg.action_loss_weight}",
+        f"lora-r{cfg.lora_rank}",
+    ]
+    if cfg.image_aug:
+        parts.append("image_aug")
+    if cfg.run_id_note:
+        parts.append(cfg.run_id_note)
+    return "--".join(parts)
+
+
+# ----------------------------------------------------------------------------
+# Main
+# ----------------------------------------------------------------------------
+
+@draccus.wrap()
+def main(cfg: Phase2OnlyConfig) -> None:
+    assert cfg.use_lora, "Phase 2-only currently only supports LoRA."
+    assert cfg.teacher_cache_dir is not None, "Phase 2-only requires --teacher_cache_dir."
+    assert not (cfg.use_l1_regression and cfg.use_diffusion)
+
+    cfg.vla_path = cfg.vla_path.rstrip("/")
+    remove_indices = parse_mask(cfg.remove_layers)
+
+    run_id = get_run_id(cfg, remove_indices)
+    run_dir = cfg.run_root_dir / run_id
+    os.makedirs(run_dir, exist_ok=True)
+
+    distributed_state = PartialState()
+    device_id = distributed_state.local_process_index
+    torch.cuda.set_device(device_id)
+    torch.cuda.empty_cache()
+
+    if distributed_state.is_main_process:
+        wandb.init(entity=cfg.wandb_entity, project=cfg.wandb_project,
+                   name=f"phase2only+{run_id}")
+        print(f"[phase2-only] removing layers: {remove_indices}  "
+              f"({len(remove_indices)} of 32)")
+        print(f"[phase2-only] run_dir: {run_dir}")
+
+    print(
+        "Detected constants:\n"
+        f"\tNUM_ACTIONS_CHUNK: {NUM_ACTIONS_CHUNK}\n"
+        f"\tACTION_DIM: {ACTION_DIM}\n"
+        f"\tPROPRIO_DIM: {PROPRIO_DIM}\n"
+        f"\tACTION_PROPRIO_NORMALIZATION_TYPE: {ACTION_PROPRIO_NORMALIZATION_TYPE}"
+    )
+
+    # === Load Student Model (Gated, but Phase-1 components unused) ===
+    if model_is_on_hf_hub(cfg.vla_path):
+        cfg.vla_path = snapshot_download(repo_id=cfg.vla_path)
+    else:
+        AutoConfig.register("openvla", OpenVLAConfig, exist_ok=True)
+        AutoImageProcessor.register(OpenVLAConfig, PrismaticImageProcessor, exist_ok=True)
+        AutoProcessor.register(OpenVLAConfig, PrismaticProcessor, exist_ok=True)
+        AutoModelForVision2Seq.register(OpenVLAConfig, GatedOpenVLAForActionPrediction, exist_ok=True)
+
+    if distributed_state.is_main_process:
+        update_auto_map(cfg.vla_path)
+        check_model_logic_mismatch(cfg.vla_path)
+    dist.barrier()
+
+    processor = AutoProcessor.from_pretrained(cfg.vla_path, trust_remote_code=True)
+    vla = GatedOpenVLAForActionPrediction.from_pretrained(
+        cfg.vla_path, torch_dtype=torch.bfloat16, low_cpu_mem_usage=True,
+    ).to(device_id)
+    vla.vision_backbone.set_num_images_in_input(cfg.num_images_in_input)
+
+    # === Apply hard mask BEFORE LoRA wrap ===
+    result = apply_layer_mask(vla, remove_indices)
+    if distributed_state.is_main_process:
+        print(f"[phase2-only] kept layers   ({len(result['kept_layers'])}): {result['kept_layers']}")
+        print(f"[phase2-only] removed layers ({len(result['removed_layers'])}): {result['removed_layers']}")
+        wandb.log({
+            "Pruning/Num Kept Layers": len(result["kept_layers"]),
+            "Pruning/Num Removed Layers": len(result["removed_layers"]),
+        }, step=0)
+
+    # === Teacher cache ===
+    print(f"[Cached Mode] Loading teacher cache from: {cfg.teacher_cache_dir}")
+    teacher_cache = TeacherOutputCache(cfg.teacher_cache_dir)
+    print(f"[Cached Mode] {len(teacher_cache)} cached samples loaded")
+    AutoModelForVision2Seq.register(OpenVLAConfig, GatedOpenVLAForActionPrediction, exist_ok=True)
+
+    # === LoRA ===
+    lora_alpha_eff = cfg.lora_alpha if cfg.lora_alpha is not None else min(cfg.lora_rank, 16)
+    lora_config = LoraConfig(
+        r=cfg.lora_rank,
+        lora_alpha=lora_alpha_eff,
+        lora_dropout=cfg.lora_dropout,
+        target_modules="all-linear",
+        init_lora_weights="gaussian",
+    )
+    vla = get_peft_model(vla, lora_config)
+    vla.print_trainable_parameters()
+
+    # === DDP wrap ===
+    vla = wrap_ddp(vla, device_id, find_unused=True)
+
+    # === Sidecar modules ===
+    proprio_projector = None
+    action_head = None
+
+    if cfg.use_proprio:
+        proprio_projector = init_module(
+            ProprioProjector, "proprio_projector", cfg, device_id,
+            {"llm_dim": vla.module.llm_dim, "proprio_dim": PROPRIO_DIM},
+            pretrained_path=cfg.vla_path,
+        )
+
+    if cfg.use_l1_regression:
+        action_head = init_module(
+            L1RegressionActionHead, "action_head", cfg, device_id,
+            {"input_dim": vla.module.llm_dim, "hidden_dim": vla.module.llm_dim,
+             "action_dim": ACTION_DIM},
+            to_bf16=True,
+            pretrained_path=cfg.vla_path,
+        )
+
+    # === Optimizer ===
+    trainable_params = [p for p in vla.parameters() if p.requires_grad]
+    if action_head is not None:
+        trainable_params += [p for p in action_head.parameters() if p.requires_grad]
+    if proprio_projector is not None:
+        trainable_params += [p for p in proprio_projector.parameters() if p.requires_grad]
+    print(f"Phase 2-only trainable params: {sum(p.numel() for p in trainable_params)}")
+
+    optimizer = AdamW(trainable_params, lr=cfg.learning_rate)
+    original_lr = optimizer.param_groups[0]["lr"]
+    scheduler = MultiStepLR(optimizer, milestones=[cfg.num_steps_before_decay], gamma=0.1)
+
+    # === Action Tokenizer + Dataset ===
+    action_tokenizer = ActionTokenizer(processor.tokenizer)
+    use_wrist_image = cfg.num_images_in_input > 1
+    batch_transform = RLDSBatchTransform(
+        action_tokenizer,
+        processor.tokenizer,
+        image_transform=processor.image_processor.apply_transform,
+        prompt_builder_fn=PurePromptBuilder,
+        use_wrist_image=use_wrist_image,
+        use_proprio=cfg.use_proprio,
+    )
+    train_dataset = RLDSDataset(
+        cfg.data_root_dir, cfg.dataset_name, batch_transform,
+        resize_resolution=tuple(vla.module.config.image_sizes),
+        shuffle_buffer_size=cfg.shuffle_buffer_size,
+        image_aug=cfg.image_aug,
+    )
+    if distributed_state.is_main_process:
+        save_dataset_statistics(train_dataset.dataset_statistics, run_dir)
+
+    collator = PaddedCollatorForActionPrediction(
+        processor.tokenizer.model_max_length,
+        processor.tokenizer.pad_token_id,
+        padding_side="right",
+    )
+    dataloader = DataLoader(
+        train_dataset, batch_size=cfg.batch_size, sampler=None,
+        collate_fn=collator, num_workers=0,
+    )
+
+    # === NUM_PATCHES ===
+    # The formula vision_backbone.get_num_patches() * num_images_in_input
+    # is off-by-one against the actual sequence prefix produced by the model
+    # (there's an extra inserted position; the cache metadata stores the
+    # empirically-correct value). Prefer the cache metadata; fall back to
+    # the formula + 1 if the cache wasn't built with that field.
+    cache_num_patches = teacher_cache.metadata.get("num_patches")
+    if cache_num_patches is not None:
+        NUM_PATCHES = int(cache_num_patches)
+    else:
+        NUM_PATCHES = (
+            vla.module.vision_backbone.get_num_patches()
+            * vla.module.vision_backbone.get_num_images_in_input()
+            + 1
+        )
+    if distributed_state.is_main_process:
+        print(f"[phase2-only] NUM_PATCHES = {NUM_PATCHES} "
+              f"(source: {'cache_metadata' if cache_num_patches else 'formula+1'})")
+
+    # === Metrics deques ===
+    recent_metrics = {
+        "loss_value": deque(maxlen=cfg.grad_accumulation_steps),
+        "action_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "kl_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "teacher_gt_loss": deque(maxlen=cfg.grad_accumulation_steps),
+    }
+
+    # ------------------------------------------------------------------
+    # B-2 SignalRecorder (optional, gated by cfg.signal_record_dir)
+    # ------------------------------------------------------------------
+    signal_recorder = None
+    if cfg.signal_record_dir and distributed_state.is_main_process:
+        try:
+            from phase1.training_signals import SignalRecorder
+            signal_recorder = SignalRecorder(
+                record_dir=cfg.signal_record_dir,
+                remove_list=remove_indices,
+                log_freq=cfg.signal_log_freq,
+                rollout_freq=cfg.signal_rollout_freq,
+                enable_bi=cfg.signal_enable_bi,
+                enable_attn_entropy=cfg.signal_enable_attn_entropy,
+                enable_action_consistency=cfg.signal_enable_action_consistency,
+                enable_partial_rollout=cfg.signal_enable_partial_rollout,
+            )
+            print(f"[phase2-only] SignalRecorder ON  dir={cfg.signal_record_dir}  "
+                  f"log_freq={cfg.signal_log_freq}")
+        except Exception as e:
+            print(f"[phase2-only] WARN: SignalRecorder init failed: {e}")
+            signal_recorder = None
+
+    # ------------------------------------------------------------------
+    # Training loop (Phase 2 logic only)
+    # ------------------------------------------------------------------
+    print(f"[phase2-only] starting Phase 2 training for {cfg.max_steps} steps")
+    log_step = 0
+    t_start = time.time()
+
+    for batch_idx, batch in enumerate(dataloader):
+        gradient_step_idx = log_step  # 1:1 since grad_accumulation_steps=1 default
+
+        loss, metrics = run_phase2_forward_pass(
+            vla=vla,
+            teacher_vla=None,
+            action_head=action_head,
+            teacher_action_head=None,
+            noisy_action_projector=None,
+            proprio_projector=proprio_projector,
+            teacher_noisy_action_projector=None,
+            teacher_proprio_projector=None,
+            batch=batch,
+            action_tokenizer=action_tokenizer,
+            device_id=device_id,
+            use_l1_regression=cfg.use_l1_regression,
+            use_diffusion=cfg.use_diffusion,
+            use_proprio=cfg.use_proprio,
+            use_film=cfg.use_film,
+            num_patches=NUM_PATCHES,
+            cfg=cfg,
+            teacher_cache=teacher_cache,
+        )
+
+        normalized_loss = loss / cfg.grad_accumulation_steps
+        normalized_loss.backward()
+
+        # B-2: capture grad-norm signals AFTER backward, BEFORE optimizer.step
+        if signal_recorder is not None:
+            signal_recorder.on_step_post_backward(log_step, vla)
+
+        for k, v in metrics.items():
+            if k in recent_metrics:
+                recent_metrics[k].append(v)
+
+        smoothened_metrics = compute_smoothened_metrics(recent_metrics)
+
+        # B-2: capture per-step act/kl/per-task-var (uses smoothened metrics)
+        if signal_recorder is not None:
+            signal_recorder.on_step_pre_backward(log_step, batch, smoothened_metrics)
+
+        if distributed_state.is_main_process and log_step % cfg.wandb_log_freq == 0:
+            log_metrics_to_wandb(smoothened_metrics, "VLA Train", log_step, wandb)
+
+            # Teacher cache hit-rate
+            if teacher_cache is not None:
+                stats = teacher_cache.get_stats(reset=True)
+                if stats["total"] > 0:
+                    wandb.log({
+                        "TeacherCache/hit_rate": stats["hit_rate"],
+                        "TeacherCache/hits": stats["hits"],
+                        "TeacherCache/misses": stats["misses"],
+                    }, step=log_step)
+                    if stats["hit_rate"] < 1.0:
+                        print(
+                            f"[TeacherCache] step={log_step} "
+                            f"hit_rate={stats['hit_rate']:.4f} "
+                            f"({stats['hits']}/{stats['total']}, "
+                            f"miss={stats['misses']})"
+                        )
+
+        if cfg.lr_warmup_steps > 0:
+            lr_progress = min((gradient_step_idx + 1) / cfg.lr_warmup_steps, 1.0)
+            current_lr = original_lr * (0.1 + 0.9 * lr_progress)
+            for pg in optimizer.param_groups:
+                pg["lr"] = current_lr
+
+        if distributed_state.is_main_process and log_step % cfg.wandb_log_freq == 0:
+            wandb.log({"VLA Train/Learning Rate": scheduler.get_last_lr()[0]}, step=log_step)
+
+        if (batch_idx + 1) % cfg.grad_accumulation_steps == 0:
+            optimizer.step()
+            scheduler.step()
+            optimizer.zero_grad()
+
+        # B-2: flush signal row at end of step + optional partial rollout
+        if signal_recorder is not None:
+            signal_recorder.on_step_post_optim(log_step, vla, optimizer)
+            if cfg.signal_enable_partial_rollout and log_step > 0 \
+                    and log_step % cfg.signal_rollout_freq == 0:
+                signal_recorder.on_partial_rollout(
+                    log_step, vla, processor, action_head,
+                    env_factory=None,  # TODO: provide LIBERO env factory
+                )
+
+        # Save checkpoint
+        if log_step > 0 and log_step % cfg.save_freq == 0:
+            save_training_checkpoint(
+                cfg=cfg, run_dir=run_dir, log_step=log_step,
+                vla=vla, processor=processor,
+                proprio_projector=proprio_projector,
+                noisy_action_projector=None,
+                action_head=action_head,
+                train_dataset=train_dataset,
+                distributed_state=distributed_state,
+                gating_network=None,
+                is_phase2=True,
+                final_p_keep=None,  # we already stripped layers; merge step has nothing to do
+            )
+
+        log_step += 1
+
+        # Periodic stdout heartbeat (every 100 steps)
+        if log_step % 100 == 0 and distributed_state.is_main_process:
+            elapsed = time.time() - t_start
+            sps = log_step / max(elapsed, 1e-6)
+            eta_sec = (cfg.max_steps - log_step) / max(sps, 1e-6)
+            print(f"[phase2-only] step {log_step}/{cfg.max_steps}  "
+                  f"loss={smoothened_metrics.get('loss_value', float('nan')):.4f}  "
+                  f"act={smoothened_metrics.get('action_loss', float('nan')):.4f}  "
+                  f"kl={smoothened_metrics.get('kl_loss', float('nan')):.4f}  "
+                  f"({sps:.2f} step/s, ETA {eta_sec/60:.1f} min)")
+
+        if log_step >= cfg.max_steps:
+            print(f"[phase2-only] reached max_steps={cfg.max_steps}; stopping.")
+            break
+
+    # Final checkpoint
+    save_training_checkpoint(
+        cfg=cfg, run_dir=run_dir, log_step=log_step,
+        vla=vla, processor=processor,
+        proprio_projector=proprio_projector,
+        noisy_action_projector=None,
+        action_head=action_head,
+        train_dataset=train_dataset,
+        distributed_state=distributed_state,
+        gating_network=None, is_phase2=True, final_p_keep=None,
+    )
+    if signal_recorder is not None:
+        signal_recorder.close()
+        print(f"[phase2-only] SignalRecorder closed: {cfg.signal_record_dir}")
+
+    print(f"[phase2-only] DONE. total wall-clock: {(time.time() - t_start) / 60:.1f} min")
+
+
+if __name__ == "__main__":
+    main()
