+def init_teacher_module(
+    module_class: Type[nn.Module],
+    module_name: str,
+    teacher_path: Optional[str],
+    device_id: int,
+    module_args: dict,
+    to_bf16: bool = False,
+) -> DDP:
+    """Initialize a frozen teacher sidecar module, optionally loading weights."""
+    module = module_class(**module_args)
+    # Try to load teacher checkpoint if path provided
+    if teacher_path is not None:
+        ckpt_path = os.path.join(teacher_path, f"{module_name}--latest_checkpoint.pt")
+        if not os.path.exists(ckpt_path):
+            candidates = sorted(glob.glob(os.path.join(teacher_path, f"{module_name}--*_checkpoint.pt")))
+            ckpt_path = candidates[-1] if candidates else None
+        if ckpt_path is not None and os.path.exists(ckpt_path):
+            state_dict = load_checkpoint_by_path(ckpt_path)
