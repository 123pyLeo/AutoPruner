diff --git a/prismatic/models/layer_pruning.py b/prismatic/models/layer_pruning.py
new file mode 100644
index 0000000..22c05e2
--- /dev/null
+++ b/prismatic/models/layer_pruning.py
@@ -0,0 +1,190 @@
+"""
+Layer Pruning Modules for OpenVLA-OFT.
+
+Implements:
+  - gumbel_sigmoid: Temperature-controlled Gumbel-Sigmoid activation with STE.
+  - GatingTransformerBlock: Lightweight Transformer block for the gating network.
+  - InputDependentLayerGatingNetwork: Input-dependent layer gating network.
+  - strip_pruned_layers: Physically remove LLM decoder layers based on retention probabilities.
+"""
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+def gumbel_sigmoid(
+    logits: torch.Tensor,
+    tau: float = 1.0,
+    hard: bool = False,
+    training: bool = True,
+) -> torch.Tensor:
+    """
+    Gumbel-Sigmoid activation with optional straight-through estimator (STE).
+
+    Binary Concrete relaxation: y = (logit + (g1 - g2)) / tau, where g1, g2
+    are i.i.d. Gumbel(0, 1). Their difference is Logistic(0, 1) (mean 0),
+    which we sample directly to avoid the +0.577 bias of a single Gumbel.
+
+    Args:
+        logits: [B, L] or [L], one scalar gate logit per layer.
+        tau: Temperature parameter (anneal from high to low).
+        hard: If True, return {0, 1} via STE (forward is discrete, backward through sigmoid).
+        training: If True, add Logistic noise; otherwise use deterministic sigmoid.
+
+    Returns:
+        p_keep: [B, L], retention probabilities (hard=True gives binary with gradient).
+    """
+    if training:
+        # Logistic(0, 1) noise == difference of two i.i.d. Gumbel(0, 1)
+        u = torch.rand_like(logits).clamp(1e-6, 1.0 - 1e-6)
+        logistic_noise = torch.log(u) - torch.log1p(-u)
+        y = (logits + logistic_noise) / tau
+    else:
+        y = logits
+    p_keep = torch.sigmoid(y)
+    if hard:
+        z_hard = (p_keep > 0.5).float()
+        p_keep = z_hard - p_keep.detach() + p_keep  # STE
+    return p_keep
+
+
+class GatingTransformerBlock(nn.Module):
+    """Lightweight Transformer block for the gating network."""
+
+    def __init__(self, d_model: int, num_heads: int, dropout: float = 0.1):
+        super().__init__()
+        self.attn = nn.MultiheadAttention(d_model, num_heads, dropout=dropout, batch_first=True)
+        self.norm1 = nn.LayerNorm(d_model)
+        self.ffn = nn.Sequential(
+            nn.Linear(d_model, 4 * d_model),
+            nn.GELU(),
+            nn.Dropout(dropout),
+            nn.Linear(4 * d_model, d_model),
+            nn.Dropout(dropout),
+        )
+        self.norm2 = nn.LayerNorm(d_model)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        attn_out, _ = self.attn(x, x, x)
+        x = self.norm1(x + attn_out)
+        x = self.norm2(x + self.ffn(x))
+        return x
+
+
+class InputDependentLayerGatingNetwork(nn.Module):
+    """
+    Input-dependent layer gating network.
+
+    Takes mean-pooled per-layer hidden states from the LLM decoder and outputs
+    scalar gate logits per layer. Uses Gumbel-Sigmoid for differentiable
+    discrete gating with temperature annealing.
+    """
+
+    def __init__(
+        self,
+        num_layers: int,
+        hidden_dim: int,
+        d_gate: int = 512,
+        num_heads: int = 8,
+        num_blocks: int = 1,
+    ):
+        """
+        Args:
+            num_layers: Number of LLM decoder layers (e.g., 32).
+            hidden_dim: LLM hidden size (e.g., 4096).
+            d_gate: Internal dimension of the gating network.
+            num_heads: Number of attention heads in the Transformer blocks.
+            num_blocks: Number of Transformer blocks.
+        """
+        super().__init__()
+        self.num_layers = num_layers
+        # Project LLM hidden_dim -> d_gate
+        self.input_proj = nn.Linear(hidden_dim, d_gate)
+        # Layer-level positional embedding
+        self.layer_pos_emb = nn.Embedding(num_layers, d_gate)
+        # Transformer blocks
+        self.transformer_blocks = nn.ModuleList(
+            [GatingTransformerBlock(d_gate, num_heads) for _ in range(num_blocks)]
+        )
+        # Gate head: output 1 scalar logit per layer
+        self.gate_head = nn.Linear(d_gate, 1)
+
+    def forward(
+        self,
+        layer_hidden_states: torch.Tensor,
+        tau: float = 1.0,
+        threshold: float = 0.5,
+        training: bool = True,
+    ) -> dict:
+        """
+        Args:
+            layer_hidden_states: [B, L, D] mean-pooled hidden states per layer.
+            tau: Gumbel-Sigmoid temperature.
+            threshold: Binarization threshold.
+            training: Whether in training mode (controls Gumbel noise).
+
+        Returns:
+            dict with keys:
+                gate_logits: [B, L] raw gate logits.
+                p_keep: [B, L] soft retention probabilities.
+                z_keep: [B, L] binary gates (0/1) with STE gradients.
+        """
+        B, L, D = layer_hidden_states.shape
+        # Project to gate space
+        h = self.input_proj(layer_hidden_states)  # [B, L, d_gate]
+        # Add layer positional encoding
+        pos = self.layer_pos_emb(torch.arange(L, device=h.device))  # [L, d_gate]
+        h = h + pos.unsqueeze(0)  # [B, L, d_gate]
+        # Pass through Transformer blocks
+        for block in self.transformer_blocks:
+            h = block(h)  # [B, L, d_gate]
+        # Gate head -> scalar logit per layer
+        gate_logits = self.gate_head(h).squeeze(-1)  # [B, L]
+        # Gumbel-Sigmoid -> soft probability
+        p_keep = gumbel_sigmoid(gate_logits, tau=tau, hard=False, training=training)
+        # Binarize gates with STE
+        z_hard = (p_keep > threshold).float()
+        z_keep = z_hard - p_keep.detach() + p_keep  # STE
+        return {"gate_logits": gate_logits, "p_keep": p_keep, "z_keep": z_keep}
+
+
+def strip_pruned_layers(model, p_keep_avg: torch.Tensor, threshold: float = 0.5) -> dict:
+    """
+    Physically remove LLM decoder layers where p_keep < threshold.
+
+    Args:
+        model: GatedOpenVLAForActionPrediction (or its .module unwrapped from DDP).
+        p_keep_avg: [L] tensor, average retention probability per layer.
+        threshold: Retention threshold.
+
+    Returns:
+        dict: {"kept_layers": [indices], "removed_layers": [indices]}
+    """
+    # Navigate to LlamaModel layers
+    # Path: model.language_model.model.layers
+    # With LoRA (PEFT): model.base_model.model.language_model.model.layers
+    if hasattr(model, "base_model"):
+        # PEFT-wrapped model
+        inner_model = model.base_model.model
+    else:
+        inner_model = model
+
+    llama_model = inner_model.language_model.model  # GatedLlamaModel / LlamaModel
+
+    all_indices = list(range(len(llama_model.layers)))
+    kept = [i for i in all_indices if p_keep_avg[i].item() >= threshold]
+    removed = [i for i in all_indices if i not in kept]
+
+    # Replace layers with only the kept ones
+    llama_model.layers = nn.ModuleList([llama_model.layers[i] for i in kept])
+
+    # Update each decoder layer's layer_idx so cache indexing works correctly
+    for new_idx, layer in enumerate(llama_model.layers):
+        layer.self_attn.layer_idx = new_idx
+
+    # Update config to reflect new layer count
+    llama_model.config.num_hidden_layers = len(kept)
+    inner_model.config.text_config.num_hidden_layers = len(kept)
+
+    return {"kept_layers": kept, "removed_layers": removed}
diff --git a/prismatic/training/replacement_adapter.py b/prismatic/training/replacement_adapter.py
new file mode 100644
index 0000000..aca766c
--- /dev/null
+++ b/prismatic/training/replacement_adapter.py
@@ -0,0 +1,299 @@
+"""
+Replacement adapter (LLM-Streamline-lite) for layer-pruned VLA recovery.
+
+For each contiguous removed-layer segment, insert a tiny gated MLP at the
+position of the *kept layer immediately following* the segment. The adapter
+acts on the residual stream input to that kept layer:
+
+    h' = h + up( silu(down(rmsnorm(h))) )
+
+up.weight is zero-initialized, so the adapter starts as identity. Trainable
+params per adapter ≈ 2 * 4096 * bottleneck (default 1024) ≈ 8M.
+
+Helpers expose:
+    - Adapter (nn.Module)
+    - find_boundary_indices(remove_layers): which student-layer indices need adapter
+    - install_adapters(model, remove_layers, ...): wraps boundary layers with adapter
+    - save_adapters / load_adapters
+"""
+
+from __future__ import annotations
+
+from typing import Dict, List
+
+import torch
+import torch.nn as nn
+
+
+class _RMSNorm(nn.Module):
+    def __init__(self, dim: int, eps: float = 1e-6):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(dim))
+        self.eps = eps
+
+    def forward(self, x):
+        var = x.to(torch.float32).pow(2).mean(dim=-1, keepdim=True)
+        x = x * torch.rsqrt(var + self.eps).to(x.dtype)
+        return x * self.weight
+
+
+class Adapter(nn.Module):
+    """Original 1-layer MLP adapter: RMSNorm → down → SiLU → up + residual.
+    Per-token, no cross-token reasoning."""
+    def __init__(self, hidden_size: int = 4096, bottleneck: int = 1024):
+        super().__init__()
+        self.norm = _RMSNorm(hidden_size)
+        self.down = nn.Linear(hidden_size, bottleneck, bias=False)
+        self.act = nn.SiLU()
+        self.up = nn.Linear(bottleneck, hidden_size, bias=False)
+        nn.init.normal_(self.down.weight, std=0.02)
+        nn.init.zeros_(self.up.weight)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return x + self.up(self.act(self.down(self.norm(x))))
+
+
+class ResMLPAdapter(nn.Module):
+    """Stack of N residual MLP blocks (Adapter-style). Same per-token nature
+    as Adapter but deeper. Tests whether depth alone helps."""
+    def __init__(self, hidden_size: int = 4096, bottleneck: int = 1024, n_blocks: int = 2):
+        super().__init__()
+        self.blocks = nn.ModuleList([
+            Adapter(hidden_size=hidden_size, bottleneck=bottleneck)
+            for _ in range(n_blocks)
+        ])
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        for blk in self.blocks:
+            x = blk(x)  # Adapter already has residual
+        return x
+
+
+class TransformerAdapter(nn.Module):
+    """Transformer-block adapter: bottlenecked self-attention + MLP, both residual.
+    Adds cross-token reasoning. Tests whether attention is the missing capability
+    for sub-goal switching.
+
+    Params (with hidden=4096, attn_bottleneck=1024, mlp_bottleneck=1024, n_heads=16):
+      - QKV proj (down): 3 × 4096 × 1024 ≈ 12.6M
+      - Out proj (up):   1024 × 4096 ≈ 4.2M
+      - MLP down + up:   2 × 4096 × 1024 ≈ 8.4M
+      Total ≈ 26M (vs original Adapter 8M, vs full Llama block ~200M)
+    """
+    def __init__(self, hidden_size: int = 4096, attn_bottleneck: int = 1024,
+                 mlp_bottleneck: int = 1024, n_heads: int = 16):
+        super().__init__()
+        assert attn_bottleneck % n_heads == 0, \
+            f"attn_bottleneck {attn_bottleneck} must divide n_heads {n_heads}"
+        self.n_heads = n_heads
+        self.head_dim = attn_bottleneck // n_heads
+        self.attn_dim = attn_bottleneck
+
+        # Pre-attn norm
+        self.norm1 = _RMSNorm(hidden_size)
+        # Bottlenecked Q/K/V: project hidden → attn_bottleneck
+        self.q_proj = nn.Linear(hidden_size, attn_bottleneck, bias=False)
+        self.k_proj = nn.Linear(hidden_size, attn_bottleneck, bias=False)
+        self.v_proj = nn.Linear(hidden_size, attn_bottleneck, bias=False)
+        # Out proj: attn_bottleneck → hidden
+        self.o_proj = nn.Linear(attn_bottleneck, hidden_size, bias=False)
+        # MLP block (same form as Adapter)
+        self.norm2 = _RMSNorm(hidden_size)
+        self.mlp_down = nn.Linear(hidden_size, mlp_bottleneck, bias=False)
+        self.mlp_act = nn.SiLU()
+        self.mlp_up = nn.Linear(mlp_bottleneck, hidden_size, bias=False)
+
+        # Init
+        for lin in [self.q_proj, self.k_proj, self.v_proj, self.mlp_down]:
+            nn.init.normal_(lin.weight, std=0.02)
+        # Zero-init output projections → starts as identity
+        nn.init.zeros_(self.o_proj.weight)
+        nn.init.zeros_(self.mlp_up.weight)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # x: (B, T, H)
+        B, T, H = x.shape
+        # === Self-attention with bottleneck ===
+        h = self.norm1(x)
+        q = self.q_proj(h).view(B, T, self.n_heads, self.head_dim).transpose(1, 2)  # (B, n_heads, T, head_dim)
+        k = self.k_proj(h).view(B, T, self.n_heads, self.head_dim).transpose(1, 2)
+        v = self.v_proj(h).view(B, T, self.n_heads, self.head_dim).transpose(1, 2)
+        # CAUSAL attention to match surrounding LLM layers (Llama is causal).
+        # Without causal mask, action tokens leak future info backward, breaking
+        # the causal structure the LLM layers below/above expect.
+        attn_out = torch.nn.functional.scaled_dot_product_attention(q, k, v, is_causal=True)
+        attn_out = attn_out.transpose(1, 2).contiguous().view(B, T, self.attn_dim)
+        x = x + self.o_proj(attn_out)
+        # === MLP ===
+        x = x + self.mlp_up(self.mlp_act(self.mlp_down(self.norm2(x))))
+        return x
+
+
+class LinearAdapter(nn.Module):
+    """Single linear layer adapter; weight typically solved closed-form via OLS
+    (see scripts/solve_svd_adapter.py). Output replaces dense h_L29 directly.
+
+    For mask [14-29] this acts as the boundary translator L13_out → L30_in,
+    parametrized by a single d×d matrix (4096×4096 ≈ 16.7M params).
+    """
+    def __init__(self, hidden_size: int = 4096, bias: bool = False):
+        super().__init__()
+        self.linear = nn.Linear(hidden_size, hidden_size, bias=bias)
+        # Identity init in case weights never get loaded
+        nn.init.eye_(self.linear.weight)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.linear(x)
+
+
+class TransformerStackAdapter(nn.Module):
+    """Stack of N TransformerAdapter blocks. Used for capacity scaling.
+    state_dict keys: blocks.{i}.{q_proj,k_proj,...}.weight
+    (Distinct from single-block TransformerAdapter to preserve checkpoint compat.)
+    """
+    def __init__(self, hidden_size: int = 4096, attn_bottleneck: int = 1024,
+                 mlp_bottleneck: int = 1024, n_heads: int = 16, n_blocks: int = 2):
+        super().__init__()
+        self.blocks = nn.ModuleList([
+            TransformerAdapter(hidden_size=hidden_size,
+                               attn_bottleneck=attn_bottleneck,
+                               mlp_bottleneck=mlp_bottleneck,
+                               n_heads=n_heads)
+            for _ in range(n_blocks)
+        ])
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        for blk in self.blocks:
+            x = blk(x)
+        return x
+
+
+class _LayerWithAdapter(nn.Module):
+    """Wraps a kept LLaMA decoder layer with a pre-applied adapter."""
+
+    def __init__(self, adapter: Adapter, inner_layer: nn.Module):
+        super().__init__()
+        self.adapter = adapter
+        self.inner = inner_layer
+        # Forward-compatibility: HF's LLaMA layer exposes self_attn for layer_idx mutation
+        self.self_attn = inner_layer.self_attn
+
+    def forward(self, hidden_states, *args, **kwargs):
+        adapted = self.adapter(hidden_states)
+        return self.inner(adapted, *args, **kwargs)
+
+
+def find_boundary_indices(remove_layers: List[int], total_layers: int = 32) -> Dict[int, int]:
+    """
+    Map student-layer index → original-layer index for each kept layer that
+    follows a removed segment (i.e. previous original index was removed or is None).
+    Includes 0 if layer 0 was removed (rare; protected by convention).
+    """
+    remove_set = set(remove_layers)
+    kept = [i for i in range(total_layers) if i not in remove_set]
+    boundaries = {}
+    for j, orig in enumerate(kept):
+        prev_orig = kept[j - 1] if j > 0 else -1
+        if (orig - prev_orig) > 1:
+            boundaries[j] = orig
+    return boundaries
+
+
+def _make_adapter(adapter_type: str, hidden_size: int, bottleneck: int) -> nn.Module:
+    """Factory for adapter modules. Type ∈ {mlp, resmlp2, resmlp3, transformer}."""
+    if adapter_type == "mlp":
+        return Adapter(hidden_size=hidden_size, bottleneck=bottleneck)
+    elif adapter_type.startswith("resmlp"):
+        n = int(adapter_type.replace("resmlp", "")) if adapter_type != "resmlp" else 2
+        return ResMLPAdapter(hidden_size=hidden_size, bottleneck=bottleneck, n_blocks=n)
+    elif adapter_type == "linear":
+        return LinearAdapter(hidden_size=hidden_size, bias=False)
+    elif adapter_type == "transformer":
+        return TransformerAdapter(hidden_size=hidden_size,
+                                   attn_bottleneck=bottleneck, mlp_bottleneck=bottleneck)
+    elif adapter_type.startswith("transformer"):
+        n = int(adapter_type.replace("transformer", ""))
+        return TransformerStackAdapter(hidden_size=hidden_size,
+                                        attn_bottleneck=bottleneck,
+                                        mlp_bottleneck=bottleneck,
+                                        n_blocks=n)
+    else:
+        raise ValueError(f"unknown adapter_type {adapter_type}")
+
+
+def install_adapters(
+    model,
+    remove_layers: List[int],
+    hidden_size: int = 4096,
+    bottleneck: int = 1024,
+    total_layers: int = 32,
+    dtype: torch.dtype = torch.bfloat16,
+    adapter_type: str = "mlp",
+) -> Dict[int, nn.Module]:
+    """
+    After model layers have been pruned (i.e. model.language_model.model.layers
+    already has the kept layers only), wrap boundary kept-layers with adapters.
+    Returns a dict mapping student-layer-index → adapter module (so you can fetch
+    parameters for the optimizer / saving).
+
+    adapter_type ∈ {"mlp", "resmlp2", "resmlp3", "transformer"}
+    """
+    boundaries = find_boundary_indices(remove_layers, total_layers=total_layers)
+    layers = model.language_model.model.layers
+    assert len(layers) == (total_layers - len(set(remove_layers))), \
+        f"layers={len(layers)} but kept count={total_layers - len(set(remove_layers))}"
+    adapters: Dict[int, nn.Module] = {}
+    for j in sorted(boundaries.keys()):
+        a = _make_adapter(adapter_type, hidden_size, bottleneck).to(dtype=dtype)
+        wrapped = _LayerWithAdapter(a, layers[j]).to(dtype=dtype)
+        layers[j] = wrapped
+        adapters[j] = a
+    return adapters
+
+
+def adapter_parameters(adapters: Dict[int, Adapter]):
+    """Iterate params of all adapters, for optimizer construction."""
+    for j in sorted(adapters.keys()):
+        for p in adapters[j].parameters():
+            yield p
+
+
+def save_adapters(adapters: Dict[int, Adapter], path: str, meta: dict | None = None):
+    state = {
+        "boundaries": {int(j): adapters[j].state_dict() for j in sorted(adapters.keys())},
+        "meta": meta or {},
+    }
+    torch.save(state, path)
+
+
+def load_adapters_into_model(
+    model,
+    remove_layers: List[int],
+    adapter_path: str,
+    hidden_size: int = 4096,
+    bottleneck: int = 1024,
+    total_layers: int = 32,
+    dtype: torch.dtype = torch.bfloat16,
+    adapter_type: str = "mlp",
+) -> Dict[int, nn.Module]:
+    """Convenience for eval: install fresh adapters, then load saved weights.
+    adapter_type can be inferred from saved meta if not provided."""
+    state = torch.load(adapter_path, map_location="cpu", weights_only=False)
+    # Try to auto-detect adapter_type from saved meta
+    if adapter_type == "mlp" and isinstance(state.get("meta"), dict):
+        adapter_type = state["meta"].get("adapter_type", "mlp")
+    adapters = install_adapters(
+        model, remove_layers,
+        hidden_size=hidden_size, bottleneck=bottleneck,
+        total_layers=total_layers, dtype=dtype,
+        adapter_type=adapter_type,
+    )
+    for j_str, sd in state["boundaries"].items():
+        j = int(j_str)
+        if j not in adapters:
+            raise KeyError(f"adapter for student layer {j} not present in installed set")
+        adapters[j].load_state_dict(sd)
+    device = next(model.parameters()).device
+    for a in adapters.values():
+        a.to(device=device, dtype=dtype)
+    return adapters
diff --git a/prismatic/training/teacher_cache.py b/prismatic/training/teacher_cache.py
new file mode 100644
index 0000000..0f24660
--- /dev/null
+++ b/prismatic/training/teacher_cache.py
@@ -0,0 +1,140 @@
+"""Versioned offline teacher outputs keyed by stable sample ID and action tokens.
+
+TFDS record ID plus original frame index identifies the unaugmented source sample.
+Token bytes additionally guard tokenizer/action-chunk differences. Image augmentation
+is a documented teacher/student view choice and does not change source identity.
+"""
+import hashlib
+from pathlib import Path
+from typing import Dict, Optional
+
+import torch
+
+FORMAT = "autoprune-teacher-v2"
+IDENTITY = "tfds-record+original-frame+dataset-version+tokens"
+
+
+class TeacherOutputCache:
+    def __init__(self, cache_dir: Optional[str] = None):
+        self.cache: Dict[str, dict] = {}
+        self.metadata = {}
+        self.hits = 0
+        self.misses = 0
+        if cache_dir is not None:
+            self.load_from_disk(cache_dir)
+
+    @staticmethod
+    def compute_hash(input_ids, attention_mask=None, *, sample_id=None):
+        if not isinstance(sample_id, str) or not sample_id.strip():
+            raise ValueError("Teacher cache v2 requires a nonempty stable sample_id")
+        if input_ids.dtype not in {torch.int32, torch.int64}:
+            raise ValueError("Token IDs must be integer tensors")
+        if input_ids.ndim != 1:
+            raise ValueError("Expected one-dimensional token IDs")
+        ids = input_ids.detach().cpu().to(torch.int64)
+        if attention_mask is not None:
+            mask = attention_mask.detach().cpu()
+            if mask.shape != ids.shape or not torch.all((mask == 0) | (mask == 1)):
+                raise ValueError("Invalid token attention mask")
+            length = int(mask.sum())
+            if length < 1 or not torch.all(mask[:length] == 1) or not torch.all(mask[length:] == 0):
+                raise ValueError("Teacher cache supports nonempty right-padded tokens only")
+            ids = ids[:length]
+        if ids.numel() == 0:
+            raise ValueError("Empty teacher token sequence")
+        # Length-prefixed ID prevents ambiguous concatenations; fixed int64 little
+        # endian tokens keep the key independent of batch padding and host endian.
+        identity = sample_id.encode("utf-8")
+        payload = (FORMAT.encode() + b"\0" + len(identity).to_bytes(8, "little") + identity
+                   + ids.numpy().astype("<i8", copy=False).tobytes())
+        return hashlib.sha256(payload).hexdigest()
+
+    @staticmethod
+    def compute_batch_hashes(input_ids, attention_mask=None, *, sample_ids=None):
+        if input_ids.ndim != 2 or sample_ids is None or len(sample_ids) != len(input_ids):
+            raise ValueError("Provide one stable sample_id per batch row")
+        if attention_mask is not None and attention_mask.shape != input_ids.shape:
+            raise ValueError("Batch attention mask shape differs from token IDs")
+        return [TeacherOutputCache.compute_hash(row, None if attention_mask is None else attention_mask[i],
+                                               sample_id=sample_ids[i]) for i, row in enumerate(input_ids)]
+
+    def lookup_batch(self, input_ids, attention_mask=None, device=None, *, sample_ids=None):
+        hashes = self.compute_batch_hashes(input_ids, attention_mask, sample_ids=sample_ids)
+        missing = sum(h not in self.cache for h in hashes)
+        self.misses += missing
+        self.hits += len(hashes) - missing
+        if missing:
+            raise KeyError(f"Teacher cache v2 is missing {missing}/{len(hashes)} samples; regenerate it for this data and tokenizer")
+        entries = [self.cache[h] for h in hashes]
+        logits = torch.stack([e["teacher_logits_action_range"] for e in entries])
+        loss = torch.tensor([e["teacher_gt_loss"] for e in entries], dtype=torch.float32).mean()
+        found = torch.ones(len(hashes), dtype=torch.bool)
+        if device is not None:
+            logits, loss, found = logits.to(device), loss.to(device), found.to(device)
+        return {"teacher_logits_action_range": logits, "teacher_gt_loss": loss, "found_mask": found}
+
+    def get_stats(self, reset=False):
+        total = self.hits + self.misses
+        result = {"hit_rate": self.hits / total if total else 1., "hits":self.hits,
+                  "misses":self.misses, "total":total}
+        if reset:
+            self.hits = self.misses = 0
+        return result
+
+    def save_sample(self, input_ids, logits_action_range, gt_loss, attention_mask=None, *, sample_id=None):
+        h = self.compute_hash(input_ids, attention_mask, sample_id=sample_id)
+        if h in self.cache:
+            return False
+        if logits_action_range.ndim != 2 or not torch.isfinite(logits_action_range).all():
+            raise ValueError("Teacher logits must be a finite action-token by vocabulary tensor")
+        self.cache[h] = {"teacher_logits_action_range":logits_action_range.detach().cpu().to(torch.bfloat16),
+                         "teacher_gt_loss":float(gt_loss)}
+        return True
+
+    def save_to_disk(self, cache_dir, metadata=None):
+        meta = dict(metadata or {})
+        expected = meta.get("expected_samples")
+        if not isinstance(expected, int) or isinstance(expected, bool) or expected < 1 or expected != len(self.cache):
+            raise ValueError("Refusing incomplete teacher cache: expected_samples must equal the number of stored source samples")
+        path = Path(cache_dir)
+        path.mkdir(parents=True, exist_ok=False)
+        shard, size, index = {}, 0, 0
+        for key, entry in self.cache.items():
+            shard[key] = entry
+            size += entry["teacher_logits_action_range"].numel() * 2 + 8
+            if size >= 2 * 1024**3:
+                torch.save(shard, path / f"cache_shard_{index}.pt")
+                shard, size, index = {}, 0, index + 1
+        if shard:
+            torch.save(shard, path / f"cache_shard_{index}.pt")
+        meta.update(format=FORMAT, identity_scheme=IDENTITY, complete=True, num_samples=len(self.cache))
+        # Write completeness metadata last. A failed write never looks complete.
+        torch.save(meta, path / "metadata.pt")
+        self.metadata = meta
+
+    def load_from_disk(self, cache_dir):
+        path = Path(cache_dir)
+        if not (path / "metadata.pt").is_file():
+            raise ValueError("Teacher cache has no completeness metadata; regenerate into a fresh directory")
+        meta = torch.load(path / "metadata.pt", map_location="cpu", weights_only=True)
+        if meta.get("format") != FORMAT or meta.get("identity_scheme") != IDENTITY:
+            raise ValueError("Legacy teacher cache cannot be converted safely; regenerate teacher outputs into a fresh v2 directory")
+        expected = meta.get("expected_samples")
+        if (meta.get("complete") is not True or not isinstance(expected, int) or isinstance(expected, bool)
+                or expected < 1 or meta.get("num_samples") != expected):
+            raise ValueError("Teacher cache completeness metadata is invalid")
+        data = {}
+        for shard in sorted(path.glob("cache_shard_*.pt")):
+            part = torch.load(shard, map_location="cpu", weights_only=True)
+            if set(data).intersection(part):
+                raise ValueError("Teacher cache has overlapping shards")
+            data.update(part)
+        if len(data) != expected:
+            raise ValueError("Teacher cache shards are missing or incomplete")
+        self.metadata, self.cache = meta, data
+
+    def __len__(self):
+        return len(self.cache)
+
+    def __contains__(self, value):
+        raise TypeError("Use compute_hash with an explicit sample_id; token-only membership is ambiguous")
