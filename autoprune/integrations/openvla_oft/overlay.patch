+        batch_size=cfg.batch_size,
+        sampler=None,
+        collate_fn=collator,
+        num_workers=0,
+    )
+
+    if cfg.dataset_name not in {"libero_object_no_noops", "libero_spatial_no_noops", "libero_goal_no_noops", "libero_10_no_noops"}:
+        raise ValueError("This cache completeness contract supports the four LIBERO suites")
+    statistics = train_dataset.dataset_statistics[cfg.dataset_name]
+    expected_samples = int(statistics["num_transitions"]) - (NUM_ACTIONS_CHUNK - 1) * int(statistics["num_trajectories"])
+    if expected_samples < 1:
+        raise ValueError("Invalid LIBERO sample count")
+    cache = TeacherOutputCache()
+
+    print(f"\n[Cache] Starting teacher inference loop (NUM_PATCHES={NUM_PATCHES}, ACTION_TOKEN_BEGIN_IDX={ACTION_TOKEN_BEGIN_IDX})...")
+    with tqdm.tqdm(total=cfg.max_cache_steps, desc="Caching teacher outputs") as pbar:
+        for batch_idx, batch in enumerate(dataloader):
+            if batch_idx >= cfg.max_cache_steps:
+                raise RuntimeError("Cache generation stopped before completing the finite dataset; increase max_cache_steps")
+
+            new_count = cache_batch(cache, batch, teacher_vla=teacher_vla,
+                teacher_action_head=teacher_action_head, teacher_proprio_projector=teacher_proprio_projector,
+                device=device, cfg=cfg, num_patches=NUM_PATCHES)
+
+            pbar.update(1)
+            if batch_idx % 100 == 0:
+                pbar.set_postfix({"unique_samples": len(cache), "new_this_batch": new_count})
+
+    if len(cache) != expected_samples:
+        raise RuntimeError(f"Incomplete teacher cache: {len(cache)} samples, expected {expected_samples}")
+
+    # === Save to disk ===
+    save_dir = cfg.cache_output_dir
+    print(f"\n[Cache rank {local_rank}] Saving {len(cache)} unique samples to {save_dir}...")
+    metadata = {
+        "expected_samples": expected_samples,
+        "dataset_statistics": {key: {k: v.tolist() if hasattr(v, "tolist") else v for k, v in statistics[key].items()} for key in ("action", "proprio")},
+        "vla_path": cfg.vla_path,
+        "teacher_model_path": teacher_path,
+        "dataset_name": cfg.dataset_name,
+        "image_aug": cfg.image_aug,
+        "num_patches": NUM_PATCHES,
+        "action_token_begin_idx": ACTION_TOKEN_BEGIN_IDX,
+        "num_actions_chunk": NUM_ACTIONS_CHUNK,
+        "action_dim": ACTION_DIM,
+        "use_l1_regression": cfg.use_l1_regression,
+        "use_proprio": cfg.use_proprio,
+    }
+    cache.save_to_disk(save_dir, metadata=metadata)
+
+    print("\n[Cache] Done! You can now train with:")
+    print(f"  --teacher_cache_dir {cfg.cache_output_dir}")
+
