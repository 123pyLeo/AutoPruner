new file mode 100644
index 0000000..f80476c
--- /dev/null
+++ b/prismatic/vla/datasets/rlds/cache_identity.py
@@ -0,0 +1,34 @@
+"""Preserve official TFDS record IDs rather than order-dependent episode indices."""
+import tensorflow as tf
+import tensorflow_datasets as tfds
+
+
+class StableIdBuilder:
+    """Add tfds_id through dlimp's existing RLDS loader without changing dlimp."""
+    def __init__(self, builder):
+        self.builder = builder
+
+    def as_dataset(self, *args, **kwargs):
+        config = kwargs.get("read_config")
+        if config is None:
+            config = tfds.ReadConfig()
+        config.add_tfds_id = True
+        kwargs["read_config"] = config
+        return self.builder.as_dataset(*args, **kwargs)
+
+
+def sample_ids(traj, namespace):
+    """dlimp broadcasts tfds_id and preserves original frame indices per episode.
+
+    Namespace includes the logical dataset name and version. Rebuilding data under
+    the same version requires a new cache; IDs are scoped to that data snapshot.
+    """
+    record_ids = traj.get("traj_metadata", {}).get("tfds_id")
+    frames = traj.get("_frame_index")
+    if record_ids is None or frames is None:
+        raise ValueError("Teacher cache needs TFDS record IDs and original frame indices")
+    tf.debugging.assert_positive(tf.strings.length(record_ids), message="Empty TFDS record ID")
+    return tf.strings.join(
+        [tf.fill(tf.shape(record_ids), namespace), record_ids, tf.strings.as_string(frames)],
+        separator="|",
+    )
