diff --git a/vla-scripts/cache_teacher_outputs.py b/vla-scripts/cache_teacher_outputs.py
new file mode 100644
index 0000000..85cb578
--- /dev/null
+++ b/vla-scripts/cache_teacher_outputs.py
@@ -0,0 +1,347 @@
+"""
+cache_teacher_outputs.py
+
+Stage 1: Pre-compute and cache teacher model outputs for offline distillation.
+Iterates through the training dataset, runs the frozen teacher model, and saves
+teacher logits (action-token-range only) + teacher_gt_loss for each unique sample.
+
+Samples use a stable TFDS record/frame identity plus token bytes. A complete
+finite pass is required; legacy token-only caches are refused.
+
+Usage:
+    torchrun --nproc_per_node 1 vla-scripts/cache_teacher_outputs.py \
+        --vla_path <model_path> \
+        --dataset_name <dataset> \
+        --cache_output_dir runs/teacher_cache/<dataset>
+"""
+
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional
+
+import draccus
+import torch
+import tqdm
+from torch.utils.data import DataLoader
+from transformers import AutoConfig, AutoImageProcessor, AutoModelForVision2Seq, AutoProcessor
+
+from experiments.robot.openvla_utils import (
+    check_model_logic_mismatch,
+    model_is_on_hf_hub,
+    update_auto_map,
+)
+from prismatic.extern.hf.configuration_prismatic import OpenVLAConfig
+from prismatic.extern.hf.modeling_prismatic import OpenVLAForActionPrediction
+from prismatic.extern.hf.processing_prismatic import PrismaticImageProcessor, PrismaticProcessor
+from prismatic.models.action_heads import L1RegressionActionHead
+from prismatic.models.backbones.llm.prompting import PurePromptBuilder
+from prismatic.models.projectors import ProprioProjector
+from prismatic.training.teacher_cache import TeacherOutputCache
+from prismatic.training.train_utils import get_current_action_mask, get_next_actions_mask
+from prismatic.util.data_utils import PaddedCollatorForActionPrediction
+from prismatic.vla.action_tokenizer import ActionTokenizer
+from prismatic.vla.constants import (
+    ACTION_DIM,
+    ACTION_TOKEN_BEGIN_IDX,
+    NUM_ACTIONS_CHUNK,
+    PROPRIO_DIM,
+)
+from prismatic.vla.datasets import RLDSBatchTransform, RLDSDataset
+
+# Sane Defaults
+os.environ["TOKENIZERS_PARALLELISM"] = "false"
+
+
+def load_checkpoint_by_path(path: str, device: str = "cpu") -> dict:
+    state_dict = torch.load(path, weights_only=True, map_location=device)
+    new_state_dict = {}
+    for k, v in state_dict.items():
+        new_state_dict[k[7:] if k.startswith("module.") else k] = v
+    return new_state_dict
+
+
+@dataclass
+class CacheConfig:
+    # fmt: off
+    vla_path: str = "openvla/openvla-7b"
+    teacher_model_path: Optional[str] = None
+
+    # Dataset
+    data_root_dir: Path = Path("datasets/rlds")
+    dataset_name: str = "aloha_scoop_x_into_bowl"
+    shuffle_buffer_size: int = 100_000
+    image_aug: bool = False
+    num_images_in_input: int = 1
+    use_proprio: bool = False
+    use_l1_regression: bool = True
+    use_film: bool = False
+    batch_size: int = 8
+
+    # Cache
+    cache_output_dir: str = "runs/teacher_cache"
+    resume_from_cache: bool = False           # Legacy flag: True is rejected; use a fresh directory
+    max_cache_steps: int = 200_000            # Safety cap; reaching it before exhaustion is an error
+    # fmt: on
+
+
+def cache_batch(cache, batch, *, teacher_vla, teacher_action_head,
+                teacher_proprio_projector, device, cfg, num_patches):
+    """Generate and store one batch using the same path as the complete CLI run."""
+    NUM_PATCHES = num_patches
+    # Check which samples are new (strip padding via attention_mask before hashing)
+    batch_input_ids = batch["input_ids"]  # [B, seq_len]
+    batch_attention_mask = batch["attention_mask"]  # [B, seq_len]
+    hashes = TeacherOutputCache.compute_batch_hashes(batch_input_ids, batch_attention_mask, sample_ids=batch["cache_sample_ids"])
+    new_indices = [i for i, h in enumerate(hashes) if h not in cache.cache]
+
+    if not new_indices:
+        raise RuntimeError("Finite dataset emitted a duplicate source sample ID")
+
+    # === Teacher forward pass ===
+    with torch.no_grad():
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            teacher_output = teacher_vla(
+                input_ids=batch["input_ids"].to(device),
+                attention_mask=batch["attention_mask"].to(device),
+                pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device),
+                labels=batch["labels"].to(device),
+                output_hidden_states=True,
+                proprio=batch["proprio"].to(device) if cfg.use_proprio else None,
+                proprio_projector=teacher_proprio_projector if cfg.use_proprio else None,
+                use_film=cfg.use_film,
+            )
+
+    # === Extract teacher logits at action-token positions ===
+    # teacher_output.logits: [B, full_seq_len, vocab_size]
+    teacher_logits_text = teacher_output.logits[:, NUM_PATCHES:-1]  # [B, text_seq_len, vocab_size]
+
+    ground_truth_token_ids = batch["labels"][:, 1:].to(device)
+    current_action_mask = get_current_action_mask(ground_truth_token_ids)
+    next_actions_mask = get_next_actions_mask(ground_truth_token_ids)
+    action_mask = current_action_mask | next_actions_mask
+
+    batch_size = batch["input_ids"].shape[0]
+    n_action_tokens = NUM_ACTIONS_CHUNK * ACTION_DIM
+
+    # === Compute teacher_gt_loss per sample ===
+    if cfg.use_l1_regression and teacher_action_head is not None:
+        ground_truth_actions = batch["actions"].to(device).to(torch.bfloat16)
+        last_hidden = teacher_output.hidden_states[-1]
+        text_hidden = last_hidden[:, NUM_PATCHES:-1]
+        actions_hidden = (
+            text_hidden[action_mask]
+            .reshape(batch_size, n_action_tokens, -1)
+            .to(torch.bfloat16)
+        )
+        predicted_actions = teacher_action_head.predict_action(actions_hidden)
+        # Per-sample L1 loss
+        per_sample_gt_loss = torch.nn.L1Loss(reduction="none")(
+            ground_truth_actions, predicted_actions
+        ).mean(dim=(1, 2))  # [B]
+    else:
+        per_sample_gt_loss = torch.zeros(batch_size, device=device)
+
+    # === Save each new sample ===
+    for i in new_indices:
+        # Extract this sample's logits at action positions: [n_action_tokens, vocab_size]
+        sample_mask = action_mask[i]  # [text_seq_len] bool
+        sample_logits = teacher_logits_text[i][sample_mask]  # [n_action_tokens, vocab_size]
+
+        # Keep only action token range to save space
+        sample_logits_action_range = sample_logits[:, ACTION_TOKEN_BEGIN_IDX:]  # [n_action_tokens, action_vocab_size]
+
+        cache.save_sample(
+            input_ids=batch_input_ids[i],
+            logits_action_range=sample_logits_action_range,
+            gt_loss=per_sample_gt_loss[i].item(),
+            attention_mask=batch_attention_mask[i],
+            sample_id=batch["cache_sample_ids"][i],
+        )
+
+    return len(new_indices)
+
+
+@draccus.wrap()
+def cache_teacher(cfg: CacheConfig) -> None:
+    """Pre-compute teacher outputs and save to disk."""
+    if cfg.resume_from_cache:
+        raise ValueError("Cache v2 generation requires a fresh directory; resume is not supported")
+    if Path(cfg.cache_output_dir).exists():
+        raise FileExistsError("Choose a fresh v2 cache directory; old caches remain unchanged")
+    if cfg.image_aug:
+        raise ValueError("The v2 teacher cache uses unaugmented source views; pass --image_aug False")
+    cfg.vla_path = cfg.vla_path.rstrip("/")
+    teacher_path = cfg.teacher_model_path or cfg.vla_path
+
+    print("=" * 70)
+    print("Stage 1: Caching Teacher Outputs for Offline Distillation")
+    print("=" * 70)
+    print(f"  Teacher model  : {teacher_path}")
+    print(f"  Dataset        : {cfg.dataset_name}")
+    print(f"  Image aug      : {cfg.image_aug}")
+    print(f"  Output dir     : {cfg.cache_output_dir}")
+    print(f"  Max cache steps: {cfg.max_cache_steps}")
+    print("=" * 70)
+
+    # Cache generation uses one process and one finite dataset traversal.
+    local_rank = int(os.environ.get("LOCAL_RANK", 0))
+    world_size = int(os.environ.get("WORLD_SIZE", 1))
+    if world_size != 1:
+        raise ValueError("Finite teacher-cache generation supports one process")
+    device = torch.device(f"cuda:{local_rank}" if torch.cuda.is_available() else "cpu")
+    torch.cuda.set_device(local_rank)
+    torch.cuda.empty_cache()
+    print(f"[Cache] rank {local_rank}/{world_size} using device {device}")
+
+    # Keep source-view preprocessing reproducible.
+    import random as _random
+    import numpy as _np
+    import tensorflow as _tf
+    seed = 1000 + local_rank * 12345
+    _random.seed(seed)
+    _np.random.seed(seed)
+    torch.manual_seed(seed)
+    _tf.random.set_seed(seed)
+    print(f"[Cache] rank {local_rank} seeded with {seed}")
+
+    # === Load Teacher Model ===
+    if not model_is_on_hf_hub(cfg.vla_path):
+        AutoConfig.register("openvla", OpenVLAConfig)
+        AutoImageProcessor.register(OpenVLAConfig, PrismaticImageProcessor)
+        AutoProcessor.register(OpenVLAConfig, PrismaticProcessor)
