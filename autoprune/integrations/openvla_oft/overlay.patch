+            hidden_dim=teacher_vla.llm_dim,
+            action_dim=ACTION_DIM,
+        ).to(torch.bfloat16).to(device)
+
+        # Try to load pretrained weights
+        candidates = sorted(Path(teacher_path).glob("action_head--*_checkpoint.pt"))
+        if len(candidates) != 1:
+            raise ValueError("Teacher requires exactly one unambiguous action_head checkpoint")
+        teacher_action_head.load_state_dict(load_checkpoint_by_path(str(candidates[0])))
