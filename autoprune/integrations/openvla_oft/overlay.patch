+# === KL Divergence on Action Token Logits ===
+
+def compute_kl_divergence_on_action_logits(
+    student_logits: torch.Tensor,
+    teacher_logits: torch.Tensor,
+    action_mask: torch.Tensor,
+    temperature: float = 1.0,
+) -> torch.Tensor:
+    """
+    Compute KL(teacher || student) on action token logits.
+
+    Args:
+        student_logits: [B, seq_len, vocab_size] from student output.
+        teacher_logits: [B, seq_len, vocab_size] from teacher output.
+        action_mask: [B, seq_len] bool mask for action token positions.
+        temperature: Temperature for softmax scaling.
+
+    Returns:
+        Scalar KL divergence loss.
+    """
+    s_logits = student_logits[action_mask]  # [N_action, vocab_size]
+    t_logits = teacher_logits[action_mask]  # [N_action, vocab_size]
+    s_log_probs = F.log_softmax(s_logits / temperature, dim=-1)
+    t_probs = F.softmax(t_logits / temperature, dim=-1)
+    kl = F.kl_div(s_log_probs, t_probs, reduction="batchmean") * (temperature ** 2)
+    return kl
+
+
+def compute_kl_divergence_action_range(
+    student_logits_action_range: torch.Tensor,
+    teacher_logits_action_range: torch.Tensor,
+    temperature: float = 1.0,
+    weight_lambda: float = 0.0,
+) -> torch.Tensor:
+    """
+    Compute KL(teacher || student) using only the action-token vocabulary range.
+
+    Used with cached teacher outputs where only logits[:, ACTION_TOKEN_BEGIN_IDX:]
+    are stored. The approximation is tight because teacher probability mass at
+    action positions is almost entirely concentrated on action tokens.
+
+    Args:
+        student_logits_action_range: [N_action, action_vocab_size] from student.
+        teacher_logits_action_range: [N_action, action_vocab_size] from cache.
+        temperature: Temperature for softmax scaling.
+        weight_lambda: if > 0, uses per-position uncertainty weighting. Each
+            position's KL is multiplied by `1 + weight_lambda * (kl_per_pos / median_kl)`
+            so high-disagreement positions contribute more gradient. The weight
+            is detached (no second-order effect). weight_lambda=0 reproduces the
+            standard batchmean KL.
+
+    Returns:
+        Scalar KL divergence loss.
+    """
+    s_log_probs = F.log_softmax(student_logits_action_range / temperature, dim=-1)
+    t_log_probs = F.log_softmax(teacher_logits_action_range / temperature, dim=-1)
+    t_probs = t_log_probs.exp()
+    if weight_lambda <= 0:
+        kl = F.kl_div(s_log_probs, t_probs, reduction="batchmean") * (temperature ** 2)
+        return kl
+    # Per-position KL(teacher || student)
+    kl_per_pos = (t_probs * (t_log_probs - s_log_probs)).sum(dim=-1)
+    with torch.no_grad():
+        med = kl_per_pos.median().clamp(min=1e-6)
+        w = (1.0 + weight_lambda * (kl_per_pos / med)).clamp(max=10.0)
+    return ((kl_per_pos * w).mean()) * (temperature ** 2)
+
+
+# === Forward Pass Functions ===
+
+def run_forward_pass(
+    vla,
+    action_head,
+    noisy_action_projector,
+    proprio_projector,
+    batch,
+    action_tokenizer,
+    device_id,
+    use_l1_regression,
+    use_diffusion,
+    use_proprio,
+    use_film,
+    num_patches,
+    compute_diffusion_l1=False,
+    num_diffusion_steps_train=None,
+    layer_gates=None,
+) -> Tuple[torch.Tensor, Dict[str, float]]:
+    """
+    Compute model forward pass and metrics (same as original finetune.py but with optional layer_gates).
+    """
+    metrics = {}
+    ground_truth_actions = batch["actions"].to(device_id).to(torch.bfloat16)
+
+    # [Only for diffusion] Sample noisy actions
+    if use_diffusion:
+        noisy_dict = action_head.module.sample_noisy_actions(ground_truth_actions)
+        noise, noisy_actions, diffusion_timestep_embeddings = (
+            noisy_dict["noise"],
+            noisy_dict["noisy_actions"],
+            noisy_dict["diffusion_timestep_embeddings"],
+        )
+    else:
+        noise, noisy_actions, diffusion_timestep_embeddings = None, None, None
+
+    # VLA forward pass
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        output: CausalLMOutputWithPast = vla(
+            input_ids=batch["input_ids"].to(device_id),
+            attention_mask=batch["attention_mask"].to(device_id),
+            pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device_id),
+            labels=batch["labels"].to(device_id),
+            output_hidden_states=True,
+            proprio=batch["proprio"].to(device_id) if use_proprio else None,
+            proprio_projector=proprio_projector if use_proprio else None,
+            noisy_actions=noisy_actions if use_diffusion else None,
+            noisy_action_projector=noisy_action_projector if use_diffusion else None,
+            diffusion_timestep_embeddings=diffusion_timestep_embeddings if use_diffusion else None,
+            use_film=use_film,
+            layer_gates=layer_gates,
+        )
+
+    # Get action masks
+    ground_truth_token_ids = batch["labels"][:, 1:].to(device_id)
+    current_action_mask = get_current_action_mask(ground_truth_token_ids)
+    next_actions_mask = get_next_actions_mask(ground_truth_token_ids)
+
+    # Compute metrics for discrete action representation
+    if not (use_l1_regression or use_diffusion):
+        loss = output.loss
+        predicted_token_ids = output.logits[:, num_patches:-1].argmax(dim=2)
+        curr_action_accuracy = compute_token_accuracy(
+            predicted_token_ids, ground_truth_token_ids, mask=current_action_mask
+        )
+        curr_action_l1_loss = compute_actions_l1_loss(
+            action_tokenizer, predicted_token_ids, ground_truth_token_ids, mask=current_action_mask
+        )
+        next_actions_accuracy = compute_token_accuracy(
+            predicted_token_ids, ground_truth_token_ids, mask=next_actions_mask
+        )
+        next_actions_l1_loss = compute_actions_l1_loss(
+            action_tokenizer, predicted_token_ids, ground_truth_token_ids, mask=next_actions_mask
+        )
+        metrics.update(
+            {
+                "loss_value": loss.item(),
+                "curr_action_accuracy": curr_action_accuracy.item(),
+                "curr_action_l1_loss": curr_action_l1_loss.item(),
+                "next_actions_accuracy": next_actions_accuracy.item(),
+                "next_actions_l1_loss": next_actions_l1_loss.item(),
+            }
+        )
+    # Compute metrics for continuous action representations
+    else:
+        last_hidden_states = output.hidden_states[-1]
+        text_hidden_states = last_hidden_states[:, num_patches:-1]
+        batch_size = batch["input_ids"].shape[0]
+        actions_hidden_states = (
+            text_hidden_states[current_action_mask | next_actions_mask]
+            .reshape(batch_size, NUM_ACTIONS_CHUNK * ACTION_DIM, -1)
+            .to(torch.bfloat16)
+        )
+
+        if use_l1_regression:
+            predicted_actions = action_head.module.predict_action(actions_hidden_states)
+            loss = torch.nn.L1Loss()(ground_truth_actions, predicted_actions)
+
+        if use_diffusion:
+            noise_pred = action_head.module.predict_noise(actions_hidden_states)
+            noise_pred = noise_pred.reshape(noise.shape)
+            loss = nn.functional.mse_loss(noise_pred, noise, reduction="mean")
+
+            if compute_diffusion_l1:
+                with torch.no_grad():
+                    predicted_actions = run_diffusion_sampling(
+                        vla=vla,
+                        action_head=action_head,
+                        noisy_action_projector=noisy_action_projector,
+                        proprio_projector=proprio_projector,
+                        batch=batch,
+                        batch_size=batch_size,
+                        num_patches=num_patches,
+                        actions_shape=ground_truth_actions.shape,
+                        device_id=device_id,
+                        current_action_mask=current_action_mask,
+                        next_actions_mask=next_actions_mask,
+                        use_proprio=use_proprio,
+                        use_film=use_film,
+                    )
+
+        metrics.update({"loss_value": loss.item()})
+
+        should_log_l1_loss = not use_diffusion or (use_diffusion and compute_diffusion_l1)
+        if should_log_l1_loss:
+            ground_truth_curr_action = ground_truth_actions[:, 0]
+            predicted_curr_action = predicted_actions[:, 0]
+            ground_truth_next_actions = ground_truth_actions[:, 1:]
+            predicted_next_actions = predicted_actions[:, 1:]
+            curr_action_l1_loss = torch.nn.L1Loss()(ground_truth_curr_action, predicted_curr_action)
+            next_actions_l1_loss = torch.nn.L1Loss()(ground_truth_next_actions, predicted_next_actions)
+            metrics.update(
+                {
+                    "curr_action_l1_loss": curr_action_l1_loss.item(),
+                    "next_actions_l1_loss": next_actions_l1_loss.item(),
+                }
+            )
+
+    return loss, metrics, output
+
+
+def run_diffusion_sampling(
+    vla, action_head, noisy_action_projector, proprio_projector,
+    batch, batch_size, num_patches, actions_shape, device_id,
+    current_action_mask, next_actions_mask, use_proprio, use_film,
+) -> torch.Tensor:
+    """Run diffusion sampling (reverse diffusion) to generate actions."""
+    noise = torch.randn(
+        size=(batch_size, NUM_ACTIONS_CHUNK, ACTION_DIM), device=device_id, dtype=torch.bfloat16,
+    )
+    action_head.module.noise_scheduler.set_timesteps(action_head.module.num_diffusion_steps_train)
+    curr_noisy_actions = noise
+    for t in action_head.module.noise_scheduler.timesteps:
+        timesteps = torch.Tensor([t]).repeat(batch_size).to(device_id)
+        diffusion_timestep_embeddings = (
+            action_head.module.time_encoder(timesteps).to(curr_noisy_actions.dtype).to(curr_noisy_actions.device)
+        )
+        diffusion_timestep_embeddings = diffusion_timestep_embeddings.unsqueeze(1)
+
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            output = vla(
+                input_ids=batch["input_ids"].to(device_id),
+                attention_mask=batch["attention_mask"].to(device_id),
+                pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device_id),
+                labels=batch["labels"].to(device_id),
+                output_hidden_states=True,
+                proprio=batch["proprio"].to(device_id) if use_proprio else None,
+                proprio_projector=proprio_projector if use_proprio else None,
+                noisy_actions=curr_noisy_actions,
+                noisy_action_projector=noisy_action_projector,
+                diffusion_timestep_embeddings=diffusion_timestep_embeddings,
+                use_film=use_film,
+            )
+            last_hidden_states = output.hidden_states[-1]
+            text_hidden_states = last_hidden_states[:, num_patches:-1]
+            actions_hidden_states = text_hidden_states[current_action_mask | next_actions_mask].reshape(
+                batch_size, NUM_ACTIONS_CHUNK * ACTION_DIM, -1
+            )
+            actions_hidden_states = actions_hidden_states.to(torch.bfloat16)
+            noise_pred = action_head.module.predict_noise(actions_hidden_states)
+
+        curr_noisy_actions = action_head.module.noise_scheduler.step(noise_pred, t, curr_noisy_actions).prev_sample
+
+    return curr_noisy_actions.reshape(actions_shape)
+
+
+def compute_teacher_gt_loss(
+    teacher_output, teacher_action_head, batch, device_id,
+    use_l1_regression, use_diffusion, num_patches,
+) -> torch.Tensor:
+    """Compute teacher model's action loss vs ground truth (for logging only)."""
+    ground_truth_actions = batch["actions"].to(device_id).to(torch.bfloat16)
+    ground_truth_token_ids = batch["labels"][:, 1:].to(device_id)
+    current_action_mask = get_current_action_mask(ground_truth_token_ids)
+    next_actions_mask = get_next_actions_mask(ground_truth_token_ids)
+
+    if not (use_l1_regression or use_diffusion):
+        # Discrete: teacher CE loss
+        return teacher_output.loss
+    else:
+        last_hidden_states = teacher_output.hidden_states[-1]
+        text_hidden_states = last_hidden_states[:, num_patches:-1]
+        batch_size = batch["input_ids"].shape[0]
+        actions_hidden_states = (
+            text_hidden_states[current_action_mask | next_actions_mask]
+            .reshape(batch_size, NUM_ACTIONS_CHUNK * ACTION_DIM, -1)
+            .to(torch.bfloat16)
+        )
+        if use_l1_regression:
+            predicted_actions = teacher_action_head.predict_action(actions_hidden_states)
+            return torch.nn.L1Loss()(ground_truth_actions, predicted_actions)
+        else:
+            # For diffusion teacher, just return 0 as placeholder (noise prediction loss needs noise samples)
+            return torch.tensor(0.0, device=device_id)
+
+
+def run_pruning_forward_pass(
+    vla, teacher_vla, gating_network,
+    action_head, teacher_action_head,
+    noisy_action_projector, proprio_projector,
+    teacher_noisy_action_projector, teacher_proprio_projector,
+    batch, action_tokenizer, device_id,
+    use_l1_regression, use_diffusion, use_proprio, use_film,
+    num_patches, tau, threshold, cfg,
+    teacher_cache: "TeacherOutputCache | None" = None,
+) -> Tuple[torch.Tensor, Dict[str, float]]:
+    """
+    Phase 1 forward pass: dual forward (full + gated) + teacher forward + losses.
+
+    Returns:
+        (loss, metrics_dict)
+    """
+    metrics = {}
+    ground_truth_actions = batch["actions"].to(device_id).to(torch.bfloat16)
+
+    # [Only for diffusion] Sample noisy actions
+    if use_diffusion:
+        noisy_dict = action_head.module.sample_noisy_actions(ground_truth_actions)
+        noise, noisy_actions, diffusion_timestep_embeddings = (
+            noisy_dict["noise"],
+            noisy_dict["noisy_actions"],
+            noisy_dict["diffusion_timestep_embeddings"],
+        )
+    else:
+        noise, noisy_actions, diffusion_timestep_embeddings = None, None, None
+
+    # === Forward 1: Student full forward (collect hidden_states for gating) ===
+    # Use vla.module to bypass DDP (avoids "marked ready twice" error),
+    # and torch.no_grad() since we only need hidden states for the gating network.
+    with torch.no_grad():
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            output_full: CausalLMOutputWithPast = vla.module(
+                input_ids=batch["input_ids"].to(device_id),
+                attention_mask=batch["attention_mask"].to(device_id),
+                pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device_id),
+                labels=batch["labels"].to(device_id),
+                output_hidden_states=True,
+                proprio=batch["proprio"].to(device_id) if use_proprio else None,
+                proprio_projector=proprio_projector if use_proprio else None,
+                use_film=use_film,
+                layer_gates=None,  # No gating, full forward
+            )
+
+    # Extract per-layer hidden_states -> mean pool
+    # output_full.hidden_states = (embed_out, layer_0_out, ..., layer_L-1_out, final_norm_out)
+    # Take layer_0_out ~ layer_L-1_out (indices 1 to L)
+    num_llm_layers = len(output_full.hidden_states) - 1  # Exclude embed and final norm
+    layer_features = torch.stack(
+        [output_full.hidden_states[i + 1].mean(dim=1) for i in range(num_llm_layers)],
+        dim=1,
+    )  # [B, L, D]
+    del output_full
+    # torch.cuda.empty_cache()
+    
+    # === Gating Network ===
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        gate_outputs = gating_network.module(
+            layer_features, tau=tau, threshold=threshold, training=True
+        )
+    p_keep = gate_outputs["p_keep"]  # [B, L]
+    z_keep = gate_outputs["z_keep"]  # [B, L] (binary with STE)
+
+    # === Forward 2: Student gated forward ===
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        output_pruned: CausalLMOutputWithPast = vla(
+            input_ids=batch["input_ids"].to(device_id),
+            attention_mask=batch["attention_mask"].to(device_id),
+            pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device_id),
+            labels=batch["labels"].to(device_id),
+            output_hidden_states=True,
+            proprio=batch["proprio"].to(device_id) if use_proprio else None,
+            proprio_projector=proprio_projector if use_proprio else None,
+            noisy_actions=noisy_actions if use_diffusion else None,
+            noisy_action_projector=noisy_action_projector if use_diffusion else None,
+            diffusion_timestep_embeddings=diffusion_timestep_embeddings if use_diffusion else None,
+            use_film=use_film,
+            layer_gates=z_keep,
+        )
+
+    # === Teacher forward or cache lookup ===
+    if teacher_cache is not None:
+        # Offline mode: look up pre-computed teacher outputs by input_ids hash
+        cached = teacher_cache.lookup_batch(
+            batch["input_ids"], attention_mask=batch["attention_mask"], device=device_id,
+            sample_ids=batch.get("cache_sample_ids"),
+        )
+        teacher_logits_per_sample = cached["teacher_logits_action_range"]  # [B_found, n_act, vocab]
+        found_mask = cached["found_mask"]                                  # [B] bool
+        cached_teacher_gt_loss = cached["teacher_gt_loss"]
+        teacher_output = None
+    else:
+        # Online mode: run teacher forward pass (original behavior)
+        with torch.no_grad():
+            with torch.autocast("cuda", dtype=torch.bfloat16):
+                teacher_output: CausalLMOutputWithPast = teacher_vla(
+                    input_ids=batch["input_ids"].to(device_id),
+                    attention_mask=batch["attention_mask"].to(device_id),
+                    pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device_id),
+                    labels=batch["labels"].to(device_id),
+                    output_hidden_states=True,
+                    proprio=batch["proprio"].to(device_id) if use_proprio else None,
+                    proprio_projector=teacher_proprio_projector if use_proprio else None,
+                    noisy_actions=noisy_actions if use_diffusion else None,
+                    noisy_action_projector=teacher_noisy_action_projector if use_diffusion else None,
+                    diffusion_timestep_embeddings=diffusion_timestep_embeddings if use_diffusion else None,
+                    use_film=use_film,
+                )
+
+    # === Compute Action Loss ===
+    ground_truth_token_ids = batch["labels"][:, 1:].to(device_id)
+    current_action_mask = get_current_action_mask(ground_truth_token_ids)
+    next_actions_mask = get_next_actions_mask(ground_truth_token_ids)
+
+    if not (use_l1_regression or use_diffusion):
+        action_loss = output_pruned.loss
+    else:
+        last_hidden_states = output_pruned.hidden_states[-1]
+        text_hidden_states = last_hidden_states[:, num_patches:-1]
+        batch_size = batch["input_ids"].shape[0]
+        actions_hidden_states = (
+            text_hidden_states[current_action_mask | next_actions_mask]
+            .reshape(batch_size, NUM_ACTIONS_CHUNK * ACTION_DIM, -1)
+            .to(torch.bfloat16)
+        )
+        if use_l1_regression:
+            predicted_actions = action_head.module.predict_action(actions_hidden_states)
+            action_loss = torch.nn.L1Loss()(ground_truth_actions, predicted_actions)
+        elif use_diffusion:
+            noise_pred = action_head.module.predict_noise(actions_hidden_states)
+            noise_pred = noise_pred.reshape(noise.shape)
+            action_loss = nn.functional.mse_loss(noise_pred, noise, reduction="mean")
+
+    # === Compute KL Loss ===
+    if teacher_cache is not None:
+        # Cached mode: KL over action-token range, masked to cache-hit samples only.
+        student_logits_text = output_pruned.logits[:, num_patches:-1]
+        student_logits_masked = student_logits_text[current_action_mask | next_actions_mask]
+        student_logits_action_range = student_logits_masked[:, ACTION_TOKEN_BEGIN_IDX:]
+        if found_mask.any():
+            B = batch["input_ids"].shape[0]
+            student_per_sample = student_logits_action_range.reshape(
+                B, -1, student_logits_action_range.shape[-1]
+            )
+            student_found = student_per_sample[found_mask]
+            student_flat = student_found.reshape(-1, student_found.shape[-1])
+            teacher_flat = teacher_logits_per_sample.reshape(
+                -1, teacher_logits_per_sample.shape[-1]
+            )
+            _kl_lambda = float(getattr(cfg, "kl_weight_lambda", 0.0))
+            kl_loss = compute_kl_divergence_action_range(student_flat, teacher_flat, weight_lambda=_kl_lambda)
+        else:
+            # All miss in this batch — keep grad graph alive with a zero contribution.
+            kl_loss = student_logits_action_range.sum() * 0.0
+    else:
+        # Online mode: KL over full vocabulary
+        student_logits = output_pruned.logits[:, num_patches:-1]
+        teacher_logits = teacher_output.logits[:, num_patches:-1]
+        kl_loss = compute_kl_divergence_on_action_logits(
+            student_logits, teacher_logits,
+            action_mask=(current_action_mask | next_actions_mask),
+        )
+
+    # === Sparsity regularization (target-budget L2) ===
+    # Old: p_keep.mean() — linear in p_keep, no target budget. With sp weight tuned by hand,
+    # easy to either not prune at all (small weight) or prune everything (large weight).
+    # New: penalize squared deviation from target layer count → bidirectional pull to target.
+    num_kept_soft = p_keep.sum(dim=1).mean()                                    # Expected #layers kept (differentiable)
+    sparsity_loss = (num_kept_soft - float(cfg.target_kept_layers)).pow(2)
+
+    # === Entropy minimization on p_keep (Bernoulli) ===
+    # Pushes each gate toward {0, 1}, breaks the symmetry of the uniform
+    # p_i = K/L solution that satisfies (sum-K)^2 = 0 trivially. Only enabled
+    # when entropy_loss_weight > 0 to keep legacy behavior bit-identical.
+    eps = 1e-6
+    p_clamped = p_keep.clamp(eps, 1.0 - eps)
+    entropy_loss = -(
+        p_clamped * torch.log(p_clamped) + (1.0 - p_clamped) * torch.log(1.0 - p_clamped)
+    ).mean()
+
+    # === Total loss ===
+    loss = (
+        cfg.action_loss_weight * action_loss
+        + cfg.kl_loss_weight * kl_loss
+        + cfg.sparsity_loss_weight * sparsity_loss
+        + cfg.entropy_loss_weight * entropy_loss
+    )
+
+    # === Compute teacher_gt_loss (logging only) ===
+    if teacher_cache is not None:
+        t_gt_loss = cached_teacher_gt_loss
+    else:
+        with torch.no_grad():
+            t_gt_loss = compute_teacher_gt_loss(
+                teacher_output, teacher_action_head, batch, device_id,
+                use_l1_regression, use_diffusion, num_patches,
+            )
+
+    if teacher_output is not None:
+        del teacher_output
+    
+    metrics.update({
+        "loss_value": loss.item(),
+        "action_loss": action_loss.item(),
+        "kl_loss": kl_loss.item(),
+        "sparsity_loss": sparsity_loss.item(),
+        "entropy_loss": entropy_loss.item(),
+        "avg_p_keep": p_keep.mean().item(),
+        "p_keep_std": p_keep.std().item(),
+        "num_kept_layers": (z_keep.mean(dim=0) > 0.5).sum().item(),
+        "teacher_gt_loss": t_gt_loss.item() if isinstance(t_gt_loss, torch.Tensor) else t_gt_loss,
+    })
+
+    # Return p_keep for per-layer accumulation in training loop
+    return loss, metrics, p_keep
+
+
+def run_phase2_forward_pass(
+    vla, teacher_vla,
+    action_head, teacher_action_head,
+    noisy_action_projector, proprio_projector,
+    teacher_noisy_action_projector, teacher_proprio_projector,
+    batch, action_tokenizer, device_id,
+    use_l1_regression, use_diffusion, use_proprio, use_film,
+    num_patches, cfg,
+    teacher_cache: "TeacherOutputCache | None" = None,
+) -> Tuple[torch.Tensor, Dict[str, float]]:
+    """
+    Phase 2 forward pass: pruned student forward + teacher forward + action_loss + kl_loss.
+    """
+    metrics = {}
+    ground_truth_actions = batch["actions"].to(device_id).to(torch.bfloat16)
+
+    # [Only for diffusion] Sample noisy actions
+    if use_diffusion:
+        noisy_dict = action_head.module.sample_noisy_actions(ground_truth_actions)
+        noise, noisy_actions, diffusion_timestep_embeddings = (
+            noisy_dict["noise"],
+            noisy_dict["noisy_actions"],
+            noisy_dict["diffusion_timestep_embeddings"],
+        )
+    else:
+        noise, noisy_actions, diffusion_timestep_embeddings = None, None, None
+
+    # === Student forward (already hard pruned, no layer_gates needed) ===
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        student_output: CausalLMOutputWithPast = vla(
+            input_ids=batch["input_ids"].to(device_id),
+            attention_mask=batch["attention_mask"].to(device_id),
+            pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device_id),
+            labels=batch["labels"].to(device_id),
+            output_hidden_states=True,
+            proprio=batch["proprio"].to(device_id) if use_proprio else None,
+            proprio_projector=proprio_projector if use_proprio else None,
+            noisy_actions=noisy_actions if use_diffusion else None,
+            noisy_action_projector=noisy_action_projector if use_diffusion else None,
+            diffusion_timestep_embeddings=diffusion_timestep_embeddings if use_diffusion else None,
+            use_film=use_film,
+            layer_gates=None,
+        )
+
+    # === Teacher forward or cache lookup ===
+    if teacher_cache is not None:
+        cached = teacher_cache.lookup_batch(
+            batch["input_ids"], attention_mask=batch["attention_mask"], device=device_id,
+            sample_ids=batch.get("cache_sample_ids"),
+        )
+        teacher_logits_per_sample = cached["teacher_logits_action_range"]  # [B_found, n_act, vocab]
+        found_mask = cached["found_mask"]                                  # [B] bool
+        cached_teacher_gt_loss = cached["teacher_gt_loss"]
+        teacher_output = None
+    else:
+        with torch.no_grad():
+            with torch.autocast("cuda", dtype=torch.bfloat16):
+                teacher_output: CausalLMOutputWithPast = teacher_vla(
+                    input_ids=batch["input_ids"].to(device_id),
+                    attention_mask=batch["attention_mask"].to(device_id),
+                    pixel_values=batch["pixel_values"].to(torch.bfloat16).to(device_id),
+                    labels=batch["labels"].to(device_id),
+                    output_hidden_states=True,
+                    proprio=batch["proprio"].to(device_id) if use_proprio else None,
+                    proprio_projector=teacher_proprio_projector if use_proprio else None,
+                    noisy_actions=noisy_actions if use_diffusion else None,
+                    noisy_action_projector=teacher_noisy_action_projector if use_diffusion else None,
+                    diffusion_timestep_embeddings=diffusion_timestep_embeddings if use_diffusion else None,
+                    use_film=use_film,
+                )
+
+    # === Compute Action Loss ===
+    ground_truth_token_ids = batch["labels"][:, 1:].to(device_id)
+    current_action_mask = get_current_action_mask(ground_truth_token_ids)
+    next_actions_mask = get_next_actions_mask(ground_truth_token_ids)
+
+    if not (use_l1_regression or use_diffusion):
+        action_loss = student_output.loss
+    else:
+        last_hidden_states = student_output.hidden_states[-1]
+        text_hidden_states = last_hidden_states[:, num_patches:-1]
+        batch_size = batch["input_ids"].shape[0]
+        actions_hidden_states = (
+            text_hidden_states[current_action_mask | next_actions_mask]
+            .reshape(batch_size, NUM_ACTIONS_CHUNK * ACTION_DIM, -1)
+            .to(torch.bfloat16)
+        )
+        if use_l1_regression:
+            predicted_actions = action_head.module.predict_action(actions_hidden_states)
+            action_loss = torch.nn.L1Loss()(ground_truth_actions, predicted_actions)
+        elif use_diffusion:
+            noise_pred = action_head.module.predict_noise(actions_hidden_states)
+            noise_pred = noise_pred.reshape(noise.shape)
+            action_loss = nn.functional.mse_loss(noise_pred, noise, reduction="mean")
+
+    # === Compute KL Loss ===
+    if teacher_cache is not None:
+        student_logits_text = student_output.logits[:, num_patches:-1]
+        student_logits_masked = student_logits_text[current_action_mask | next_actions_mask]
+        student_logits_action_range = student_logits_masked[:, ACTION_TOKEN_BEGIN_IDX:]
+        if found_mask.any():
+            B = batch["input_ids"].shape[0]
+            student_per_sample = student_logits_action_range.reshape(
+                B, -1, student_logits_action_range.shape[-1]
+            )
+            student_found = student_per_sample[found_mask]
+            student_flat = student_found.reshape(-1, student_found.shape[-1])
+            teacher_flat = teacher_logits_per_sample.reshape(
+                -1, teacher_logits_per_sample.shape[-1]
+            )
+            _kl_lambda = float(getattr(cfg, "kl_weight_lambda", 0.0))
+            kl_loss = compute_kl_divergence_action_range(student_flat, teacher_flat, weight_lambda=_kl_lambda)
+        else:
+            kl_loss = student_logits_action_range.sum() * 0.0
+    else:
+        student_logits = student_output.logits[:, num_patches:-1]
+        teacher_logits = teacher_output.logits[:, num_patches:-1]
+        kl_loss = compute_kl_divergence_on_action_logits(
+            student_logits, teacher_logits,
+            action_mask=(current_action_mask | next_actions_mask),
+        )
+
+    # === Total loss (no sparsity regularization in Phase 2) ===
+    loss = cfg.action_loss_weight * action_loss + cfg.kl_loss_weight * kl_loss
+
+    # === Compute teacher_gt_loss (logging only) ===
+    if teacher_cache is not None:
+        t_gt_loss = cached_teacher_gt_loss
+    else:
+        with torch.no_grad():
+            t_gt_loss = compute_teacher_gt_loss(
+                teacher_output, teacher_action_head, batch, device_id,
+                use_l1_regression, use_diffusion, num_patches,
+            )
+
+    metrics.update({
+        "loss_value": loss.item(),
+        "action_loss": action_loss.item(),
+        "kl_loss": kl_loss.item(),
+        "teacher_gt_loss": t_gt_loss.item() if isinstance(t_gt_loss, torch.Tensor) else t_gt_loss,
+    })
+
+    return loss, metrics
+
+
+# === Smoothened Metrics & Logging ===
+
+def compute_smoothened_metrics(metrics_deques) -> dict:
+    smoothened_metrics = {}
+    for name, dq in metrics_deques.items():
+        if dq and len(dq) > 0:
+            smoothened_metrics[name] = sum(dq) / len(dq)
+    return smoothened_metrics
+
+
+def log_metrics_to_wandb(metrics, prefix, step, wandb_entity) -> None:
+    log_dict = {}
+    for name, value in metrics.items():
+        if name == "loss_value":
+            log_dict[f"{prefix}/Loss"] = value
+        else:
+            log_dict[f"{prefix}/{name.replace('_', ' ').title()}"] = value
+    wandb_entity.log(log_dict, step=step)
+
+
+# === Checkpoint Saving ===
+
+def save_training_checkpoint(
+    cfg, run_dir, log_step, vla, processor,
+    proprio_projector, noisy_action_projector, action_head,
+    train_dataset, distributed_state,
+    gating_network=None, is_phase2=False, final_p_keep=None,
+) -> None:
+    """Save all training checkpoints including pruning-specific components."""
+    if cfg.save_latest_checkpoint_only:
+        checkpoint_dir = run_dir
+        checkpoint_name_suffix = "latest_checkpoint.pt"
+    else:
+        checkpoint_dir = Path(str(run_dir) + f"--{log_step}_chkpt")
+        checkpoint_name_suffix = f"{log_step}_checkpoint.pt"
+
+    adapter_dir = checkpoint_dir / "lora_adapter"
+
+    if distributed_state.is_main_process:
+        os.makedirs(checkpoint_dir, exist_ok=True)
+        os.makedirs(adapter_dir, exist_ok=True)
+        save_dataset_statistics(train_dataset.dataset_statistics, checkpoint_dir)
+        print(f"Saving Model Checkpoint for Step {log_step}")
+
+    dist.barrier()
+
+    if distributed_state.is_main_process:
+        # Save processor and LoRA adapter
+        processor.save_pretrained(checkpoint_dir)
+        vla.module.save_pretrained(adapter_dir)
+
+        # Save sidecar modules
+        if cfg.use_proprio and proprio_projector is not None:
+            torch.save(proprio_projector.state_dict(), checkpoint_dir / f"proprio_projector--{checkpoint_name_suffix}")
+
+        if cfg.use_diffusion and noisy_action_projector is not None:
+            torch.save(
+                noisy_action_projector.state_dict(),
+                checkpoint_dir / f"noisy_action_projector--{checkpoint_name_suffix}",
+            )
+
+        if (cfg.use_l1_regression or cfg.use_diffusion) and action_head is not None:
+            torch.save(action_head.state_dict(), checkpoint_dir / f"action_head--{checkpoint_name_suffix}")
+
+        if cfg.use_film:
+            torch.save(
+                vla.module.vision_backbone.state_dict(),
+                checkpoint_dir / f"vision_backbone--{checkpoint_name_suffix}",
+            )
+
+        # Phase 1: Save gating network
+        if not is_phase2 and gating_network is not None:
+            torch.save(
+                gating_network.state_dict(),
+                checkpoint_dir / f"gating_network--{checkpoint_name_suffix}",
+            )
+
+    dist.barrier()
+
+    # LoRA merge
+    if cfg.use_lora and cfg.merge_lora_during_training:
+        if is_phase2:
+            # Phase 2: Load base model, apply same physical pruning, then merge LoRA
+            base_vla = GatedOpenVLAForActionPrediction.from_pretrained(
+                cfg.vla_path, torch_dtype=torch.bfloat16, low_cpu_mem_usage=True, trust_remote_code=True
+            )
+            if final_p_keep is not None:
+                strip_pruned_layers(base_vla, final_p_keep, cfg.pruning_threshold)
+            merged_vla = PeftModel.from_pretrained(base_vla, str(adapter_dir))
+            merged_vla = merged_vla.merge_and_unload()
+
+            if distributed_state.is_main_process:
+                merged_vla.save_pretrained(checkpoint_dir)
+                print(f"Saved merged pruned model for Step {log_step} at: {checkpoint_dir}")
+
+            dist.barrier()
+        else:
+            # Phase 1: Standard LoRA merge (full layers)
+            base_vla = AutoModelForVision2Seq.from_pretrained(
+                cfg.vla_path, torch_dtype=torch.bfloat16, low_cpu_mem_usage=True, trust_remote_code=True
+            )
+            merged_vla = PeftModel.from_pretrained(base_vla, str(adapter_dir))
+            merged_vla = merged_vla.merge_and_unload()
+
+            if distributed_state.is_main_process:
+                merged_vla.save_pretrained(checkpoint_dir)
+                print(f"Saved merged model for Step {log_step} at: {checkpoint_dir}")
+
+            dist.barrier()
+
+
+# === Main Training Function ===
+
+@draccus.wrap()
+def finetune(cfg: FinetuneConfig) -> None:
+    """Two-stage layer pruning fine-tuning for OpenVLA-OFT."""
+    assert cfg.use_lora, "Only LoRA fine-tuning is supported. Please set --use_lora=True!"
+    assert not (cfg.use_l1_regression and cfg.use_diffusion), (
+        "Cannot do both L1 regression and diffusion. Please pick one of them!"
+    )
+    assert cfg.phase1_steps < cfg.max_steps, "phase1_steps must be less than max_steps!"
+    if cfg.gumbel_anneal_steps > cfg.phase1_steps:
+        print(
+            f"[WARN] gumbel_anneal_steps={cfg.gumbel_anneal_steps} > phase1_steps={cfg.phase1_steps}; "
+            f"tau will not reach gumbel_temp_final={cfg.gumbel_temp_final}, gates stay near-random."
+        )
+
+    cfg.vla_path = cfg.vla_path.rstrip("/")
+    print(f"Fine-tuning OpenVLA (Layer Pruning: Phase1={cfg.phase1_steps} steps, Total={cfg.max_steps} steps) on `{cfg.dataset_name}`")
+
+    run_id = get_run_id(cfg)
+    run_dir = cfg.run_root_dir / run_id
+    os.makedirs(run_dir, exist_ok=True)
+
+    # GPU setup
+    distributed_state = PartialState()
+    device_id = distributed_state.local_process_index
+    torch.cuda.set_device(device_id)
+    torch.cuda.empty_cache()
+
+    if distributed_state.is_main_process:
+        wandb.init(entity=cfg.wandb_entity, project=cfg.wandb_project, name=f"prune+{run_id}")
+
+    print(
+        "Detected constants:\n"
+        f"\tNUM_ACTIONS_CHUNK: {NUM_ACTIONS_CHUNK}\n"
+        f"\tACTION_DIM: {ACTION_DIM}\n"
+        f"\tPROPRIO_DIM: {PROPRIO_DIM}\n"
+        f"\tACTION_PROPRIO_NORMALIZATION_TYPE: {ACTION_PROPRIO_NORMALIZATION_TYPE}"
+    )
+
+    # === Load Student Model (Gated) ===
+    if model_is_on_hf_hub(cfg.vla_path):
+        vla_download_path = snapshot_download(repo_id=cfg.vla_path)
+        cfg.vla_path = vla_download_path
+    else:
+        AutoConfig.register("openvla", OpenVLAConfig)
+        AutoImageProcessor.register(OpenVLAConfig, PrismaticImageProcessor)
+        AutoProcessor.register(OpenVLAConfig, PrismaticProcessor)
+        # Register gated model for student
+        AutoModelForVision2Seq.register(OpenVLAConfig, GatedOpenVLAForActionPrediction)
+
+    if distributed_state.is_main_process:
+        update_auto_map(cfg.vla_path)
+        check_model_logic_mismatch(cfg.vla_path)
+
+    dist.barrier()
+
+    processor = AutoProcessor.from_pretrained(cfg.vla_path, trust_remote_code=True)
+    vla = GatedOpenVLAForActionPrediction.from_pretrained(
+        cfg.vla_path,
+        torch_dtype=torch.bfloat16,
+        low_cpu_mem_usage=True,
+    ).to(device_id)
+
+    vla.vision_backbone.set_num_images_in_input(cfg.num_images_in_input)
+    # vla.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+
+    # === Load Teacher Model or Teacher Cache ===
+    use_teacher_cache = cfg.teacher_cache_dir is not None
+    teacher_cache = None
+    teacher_vla = None
+    teacher_path = cfg.teacher_model_path or cfg.vla_path
+
+    if use_teacher_cache:
+        # Offline mode: load pre-computed teacher outputs from disk
+        print(f"[Cached Mode] Loading teacher cache from: {cfg.teacher_cache_dir}")
+        teacher_cache = TeacherOutputCache(cfg.teacher_cache_dir)
+        print(f"[Cached Mode] {len(teacher_cache)} cached samples loaded. Teacher model will NOT be loaded.")
+        # Still need to re-register gated model
+        AutoModelForVision2Seq.register(OpenVLAConfig, GatedOpenVLAForActionPrediction)
+    else:
+        # Online mode: load full teacher model (original behavior)
+        # Re-register original model class for teacher loading
+        AutoModelForVision2Seq.register(OpenVLAConfig, OpenVLAForActionPrediction)
+        teacher_vla = AutoModelForVision2Seq.from_pretrained(
+            teacher_path,
+            torch_dtype=torch.bfloat16,
+            low_cpu_mem_usage=True,
+            trust_remote_code=True,
+        ).to(device_id)
+        teacher_vla.vision_backbone.set_num_images_in_input(cfg.num_images_in_input)
+        for p in teacher_vla.parameters():
+            p.requires_grad = False
+        teacher_vla.eval()
+        # Re-register gated model back for any future Auto usage
+        AutoModelForVision2Seq.register(OpenVLAConfig, GatedOpenVLAForActionPrediction)
+
+    # === LoRA Setup (Student) ===
+    if cfg.use_lora:
+        lora_config = LoraConfig(
+            r=cfg.lora_rank,
+            lora_alpha=min(cfg.lora_rank, 16),
+            lora_dropout=cfg.lora_dropout,
+            target_modules="all-linear",
+            init_lora_weights="gaussian",
+        )
+        vla = get_peft_model(vla, lora_config)
+        vla.print_trainable_parameters()
+
+    # FiLM setup
+    if cfg.use_film:
+        count_parameters(vla.vision_backbone, "vla.vision_backbone (original)")
+        vla.model.vision_backbone = FiLMedPrismaticVisionBackbone(
+            vision_backbone=vla.model.vision_backbone,
+            llm_dim=vla.llm_dim,
+        )
+        count_parameters(vla.vision_backbone, "vla.vision_backbone (post-wrap)")
+        if cfg.resume:
+            state_dict = load_checkpoint("vision_backbone", cfg.vla_path, cfg.resume_step)
+            vla.model.vision_backbone.load_state_dict(state_dict)
+        vla.model.vision_backbone = vla.model.vision_backbone.to(device_id)
+
+    # Wrap VLA with DDP
+    vla = wrap_ddp(vla, device_id, find_unused=True)
+
+    # === Initialize sidecar modules (student) ===
+    proprio_projector = None
+    noisy_action_projector = None
+    action_head = None
+
+    if cfg.use_proprio:
+        proprio_projector = init_module(
+            ProprioProjector, "proprio_projector", cfg, device_id,
+            {"llm_dim": vla.module.llm_dim, "proprio_dim": PROPRIO_DIM},
+            pretrained_path=cfg.vla_path,
+        )
+
+    if cfg.use_l1_regression:
+        action_head = init_module(
+            L1RegressionActionHead, "action_head", cfg, device_id,
+            {"input_dim": vla.module.llm_dim, "hidden_dim": vla.module.llm_dim, "action_dim": ACTION_DIM},
+            to_bf16=True,
+            pretrained_path=cfg.vla_path,
+        )
+
+    if cfg.use_diffusion:
+        action_head = init_module(
+            DiffusionActionHead, "action_head", cfg, device_id,
+            {
+                "input_dim": vla.module.llm_dim,
+                "hidden_dim": vla.module.llm_dim,
+                "action_dim": ACTION_DIM,
+                "num_diffusion_steps_train": cfg.num_diffusion_steps_train,
+            },
+            to_bf16=True,
+            pretrained_path=cfg.vla_path,
+        )
+        noisy_action_projector = init_module(
+            NoisyActionProjector, "noisy_action_projector", cfg, device_id,
+            {"llm_dim": vla.module.llm_dim},
+            pretrained_path=cfg.vla_path,
+        )
+
+    # === Initialize teacher sidecar modules (frozen) — skip when using cache ===
+    teacher_proprio_projector = None
+    teacher_noisy_action_projector = None
+    teacher_action_head = None
+
+    if not use_teacher_cache:
+        if cfg.use_proprio:
+            teacher_proprio_projector = init_teacher_module(
+                ProprioProjector, "proprio_projector", teacher_path, device_id,
+                {"llm_dim": teacher_vla.llm_dim, "proprio_dim": PROPRIO_DIM},
+            )
+
+        if cfg.use_l1_regression:
+            teacher_action_head = init_teacher_module(
+                L1RegressionActionHead, "action_head", teacher_path, device_id,
+                {"input_dim": teacher_vla.llm_dim, "hidden_dim": teacher_vla.llm_dim, "action_dim": ACTION_DIM},
+                to_bf16=True,
+            )
+
+        if cfg.use_diffusion:
+            teacher_action_head = init_teacher_module(
+                DiffusionActionHead, "action_head", teacher_path, device_id,
+                {
+                    "input_dim": teacher_vla.llm_dim,
+                    "hidden_dim": teacher_vla.llm_dim,
+                    "action_dim": ACTION_DIM,
+                    "num_diffusion_steps_train": cfg.num_diffusion_steps_train,
+                },
+                to_bf16=True,
+            )
+            teacher_noisy_action_projector = init_teacher_module(
+                NoisyActionProjector, "noisy_action_projector", teacher_path, device_id,
+                {"llm_dim": teacher_vla.llm_dim},
+            )
+    else:
+        print("[Cached Mode] Skipping teacher sidecar modules (not needed with cache).")
+
+    # === Initialize Gating Network (used in Phase 1) ===
+    num_llm_layers = vla.module.config.text_config.num_hidden_layers
+    gating_network = InputDependentLayerGatingNetwork(
+        num_layers=num_llm_layers,
+        hidden_dim=vla.module.llm_dim,
+        d_gate=cfg.gating_d_gate,
+        num_heads=cfg.gating_num_heads,
+        num_blocks=cfg.gating_num_blocks,
+    ).to(device_id)
+    if cfg.resume:
+        gn_state = load_checkpoint("gating_network", cfg.vla_path, cfg.resume_step)
+        gating_network.load_state_dict(gn_state)
+    gating_network = wrap_ddp(gating_network, device_id)
+    count_parameters(gating_network.module, "gating_network")
+
+    # === Get number of vision patches ===
+    NUM_PATCHES = vla.module.vision_backbone.get_num_patches() * vla.module.vision_backbone.get_num_images_in_input()
+    if cfg.use_proprio:
+        NUM_PATCHES += 1
+    if cfg.use_diffusion:
+        NUM_PATCHES += 1
+
+    # === Instantiate optimizer ===
+    trainable_params = [param for param in vla.parameters() if param.requires_grad]
+    if cfg.use_l1_regression or cfg.use_diffusion:
+        trainable_params += [param for param in action_head.parameters() if param.requires_grad]
+    if cfg.use_diffusion:
+        trainable_params += [param for param in noisy_action_projector.parameters() if param.requires_grad]
+    if cfg.use_proprio:
+        trainable_params += [param for param in proprio_projector.parameters() if param.requires_grad]
+    # Gating network parameters (Phase 1)
+    trainable_params += [param for param in gating_network.parameters() if param.requires_grad]
+    print(f"# total trainable params: {sum(p.numel() for p in trainable_params)}")
+    optimizer = AdamW(trainable_params, lr=cfg.learning_rate)
+
+    original_lr = optimizer.param_groups[0]["lr"]
+    scheduler = MultiStepLR(
+        optimizer,
+        milestones=[cfg.num_steps_before_decay],
+        gamma=0.1,
+    )
+
+    # Create Action Tokenizer
+    action_tokenizer = ActionTokenizer(processor.tokenizer)
+
+    # Load Fine-tuning Dataset
+    use_wrist_image = cfg.num_images_in_input > 1
+    batch_transform = RLDSBatchTransform(
+        action_tokenizer,
+        processor.tokenizer,
+        image_transform=processor.image_processor.apply_transform,
+        prompt_builder_fn=PurePromptBuilder,
+        use_wrist_image=use_wrist_image,
+        use_proprio=cfg.use_proprio,
+    )
+    train_dataset = RLDSDataset(
+        cfg.data_root_dir,
+        cfg.dataset_name,
+        batch_transform,
+        resize_resolution=tuple(vla.module.config.image_sizes),
+        shuffle_buffer_size=cfg.shuffle_buffer_size,
+        image_aug=cfg.image_aug,
+    )
+
+    if distributed_state.is_main_process:
+        save_dataset_statistics(train_dataset.dataset_statistics, run_dir)
+
+    collator = PaddedCollatorForActionPrediction(
+        processor.tokenizer.model_max_length, processor.tokenizer.pad_token_id, padding_side="right"
+    )
+    dataloader = DataLoader(
+        train_dataset,
+        batch_size=cfg.batch_size,
+        sampler=None,
+        collate_fn=collator,
+        num_workers=0,
+    )
+
+    # Deque to store recent train metrics (Phase 1 initially)
+    recent_metrics = {
+        "loss_value": deque(maxlen=cfg.grad_accumulation_steps),
+        "curr_action_accuracy": deque(maxlen=cfg.grad_accumulation_steps),
+        "curr_action_l1_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "next_actions_accuracy": deque(maxlen=cfg.grad_accumulation_steps),
+        "next_actions_l1_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "action_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "kl_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "teacher_gt_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "sparsity_loss": deque(maxlen=cfg.grad_accumulation_steps),
+        "avg_p_keep": deque(maxlen=cfg.grad_accumulation_steps),
+        "num_kept_layers": deque(maxlen=cfg.grad_accumulation_steps),
+    }
+
+    # === Start training ===
+    phase2_started = False
+    last_p_keep = None
+    final_p_keep = None  # Set at Phase 1→2 transition, used for Phase 2 checkpoint saving
+
+    with tqdm.tqdm(total=cfg.max_steps, leave=False) as progress:
+        vla.train()
+        optimizer.zero_grad()
+        for batch_idx, batch in enumerate(dataloader):
+            gradient_step_idx = batch_idx // cfg.grad_accumulation_steps
+            log_step = gradient_step_idx if not cfg.resume else cfg.resume_step + gradient_step_idx
+
+            if gradient_step_idx < cfg.phase1_steps:
+                # === Phase 1: Soft pruning with Gumbel-Sigmoid gating ===
+                tau = cfg.gumbel_temp_init + (cfg.gumbel_temp_final - cfg.gumbel_temp_init) * min(
+                    gradient_step_idx / max(cfg.gumbel_anneal_steps, 1), 1.0
+                )
+
+                loss, metrics, p_keep_batch = run_pruning_forward_pass(
+                    vla=vla,
+                    teacher_vla=teacher_vla,
+                    gating_network=gating_network,
+                    action_head=action_head,
+                    teacher_action_head=teacher_action_head,
+                    noisy_action_projector=noisy_action_projector if cfg.use_diffusion else None,
+                    proprio_projector=proprio_projector if cfg.use_proprio else None,
+                    teacher_noisy_action_projector=teacher_noisy_action_projector if cfg.use_diffusion else None,
+                    teacher_proprio_projector=teacher_proprio_projector if cfg.use_proprio else None,
+                    batch=batch,
+                    action_tokenizer=action_tokenizer,
+                    device_id=device_id,
+                    use_l1_regression=cfg.use_l1_regression,
+                    use_diffusion=cfg.use_diffusion,
+                    use_proprio=cfg.use_proprio,
+                    use_film=cfg.use_film,
+                    num_patches=NUM_PATCHES,
+                    tau=tau,
+                    threshold=cfg.pruning_threshold,
+                    cfg=cfg,
+                    teacher_cache=teacher_cache,
+                )
+
+                # Always keep the latest p_keep (overwrite, not accumulate)
+                last_p_keep = p_keep_batch.detach()
+
+            else:
+                # === Phase 1 → Phase 2 transition (execute once) ===
+                if not phase2_started:
+                    phase2_started = True
+
+                    # Use last batch's p_keep for hard pruning decision.
+                    # Each rank may have different p_keep due to independent Gumbel noise,
+                    # so rank 0 decides the keep_mask and broadcasts to all ranks.
+                    final_p_keep = last_p_keep.mean(dim=0)  # [L] per-layer avg
+                    num_llm_layers_now = final_p_keep.shape[0]
+                    if dist.get_rank() == 0:
+                        keep_mask = (final_p_keep >= cfg.pruning_threshold)  # bool [L]
+                    else:
+                        keep_mask = torch.zeros(num_llm_layers_now, dtype=torch.bool, device=device_id)
+                    dist.broadcast(keep_mask, src=0)
+                    # Reconstruct a consistent final_p_keep from the broadcast mask
+                    # (1.0 for kept, 0.0 for removed) so strip_pruned_layers works uniformly
+                    final_p_keep = keep_mask.float()
+
+                    print(f"\n{'='*60}")
+                    print(f"Phase 1 complete at step {gradient_step_idx}. Transitioning to Phase 2...")
+                    print(f"Keep mask (from rank 0): {keep_mask.tolist()}")
+
+                    # Physical layer removal (all ranks use identical keep_mask)
+                    result = strip_pruned_layers(vla.module, final_p_keep, cfg.pruning_threshold)
+                    print(f"Kept layers: {result['kept_layers']}")
+                    print(f"Removed layers: {result['removed_layers']}")
+                    print(f"New num_hidden_layers: {len(result['kept_layers'])}")
+
+                    # Log pruning result to WandB
+                    if distributed_state.is_main_process:
+                        wandb.log({
+                            "Pruning/Num Kept Layers": len(result["kept_layers"]),
+                            "Pruning/Num Removed Layers": len(result["removed_layers"]),
+                        }, step=log_step)
+
+                    # Delete gating network to free memory
+                    del gating_network
+                    gating_network = None
+                    torch.cuda.empty_cache()
+
+                    # Rebuild optimizer (without gating network params)
+                    trainable_params = [p for p in vla.parameters() if p.requires_grad]
+                    if cfg.use_l1_regression or cfg.use_diffusion:
+                        trainable_params += [p for p in action_head.parameters() if p.requires_grad]
+                    if cfg.use_diffusion:
+                        trainable_params += [p for p in noisy_action_projector.parameters() if p.requires_grad]
+                    if cfg.use_proprio:
+                        trainable_params += [p for p in proprio_projector.parameters() if p.requires_grad]
+                    print(f"Phase 2 trainable params: {sum(p.numel() for p in trainable_params)}")
+                    optimizer = AdamW(trainable_params, lr=cfg.learning_rate)
+                    original_lr = optimizer.param_groups[0]["lr"]
+                    scheduler = MultiStepLR(
+                        optimizer,
+                        milestones=[cfg.num_steps_before_decay],
+                        gamma=0.1,
+                    )
+
+                    # Reset recent_metrics for Phase 2 (remove Phase 1-only keys)
+                    recent_metrics = {
+                        "loss_value": deque(maxlen=cfg.grad_accumulation_steps),
+                        "curr_action_accuracy": deque(maxlen=cfg.grad_accumulation_steps),
+                        "curr_action_l1_loss": deque(maxlen=cfg.grad_accumulation_steps),
+                        "next_actions_accuracy": deque(maxlen=cfg.grad_accumulation_steps),
+                        "next_actions_l1_loss": deque(maxlen=cfg.grad_accumulation_steps),
+                        "action_loss": deque(maxlen=cfg.grad_accumulation_steps),
+                        "kl_loss": deque(maxlen=cfg.grad_accumulation_steps),
+                        "teacher_gt_loss": deque(maxlen=cfg.grad_accumulation_steps),
+                    }
+                    print(f"{'='*60}\n")
+
+                # === Phase 2: Hard-pruned distillation fine-tuning ===
+                loss, metrics = run_phase2_forward_pass(
+                    vla=vla,
+                    teacher_vla=teacher_vla,
+                    action_head=action_head,
+                    teacher_action_head=teacher_action_head,
+                    noisy_action_projector=noisy_action_projector if cfg.use_diffusion else None,
+                    proprio_projector=proprio_projector if cfg.use_proprio else None,
+                    teacher_noisy_action_projector=teacher_noisy_action_projector if cfg.use_diffusion else None,
+                    teacher_proprio_projector=teacher_proprio_projector if cfg.use_proprio else None,
+                    batch=batch,
+                    action_tokenizer=action_tokenizer,
+                    device_id=device_id,
+                    use_l1_regression=cfg.use_l1_regression,
+                    use_diffusion=cfg.use_diffusion,
+                    use_proprio=cfg.use_proprio,
+                    use_film=cfg.use_film,
+                    num_patches=NUM_PATCHES,
+                    cfg=cfg,
+                    teacher_cache=teacher_cache,
+                )
+
+            # Normalize loss for gradient accumulation
+            normalized_loss = loss / cfg.grad_accumulation_steps
+            normalized_loss.backward()
+
+            # Store recent train metrics
+            for metric_name, value in metrics.items():
+                if metric_name in recent_metrics:
+                    recent_metrics[metric_name].append(value)
+
+            # Compute smoothened train metrics
+            smoothened_metrics = compute_smoothened_metrics(recent_metrics)
+
+            # Push Metrics to W&B
+            if distributed_state.is_main_process and log_step % cfg.wandb_log_freq == 0:
+                log_metrics_to_wandb(smoothened_metrics, "VLA Train", log_step, wandb)
+                # Log Phase 1-specific metrics
+                if not phase2_started:
+                    per_layer_log = {"VLA Train/Gumbel Temperature": tau}
+                    # Log per-layer p_keep
+                    if last_p_keep is not None:
+                        layer_p_keep = last_p_keep.mean(dim=0)  # [L]
+                        for layer_idx in range(layer_p_keep.shape[0]):
+                            per_layer_log[f"Layer P_Keep/Layer {layer_idx}"] = layer_p_keep[layer_idx].item()
+                    wandb.log(per_layer_log, step=log_step)
+
+                # Teacher cache hit-rate (rank-0 sample, reset between log windows)
+                if teacher_cache is not None:
+                    cache_stats = teacher_cache.get_stats(reset=True)
+                    if cache_stats["total"] > 0:
+                        wandb.log({
+                            "TeacherCache/hit_rate": cache_stats["hit_rate"],
+                            "TeacherCache/hits": cache_stats["hits"],
+                            "TeacherCache/misses": cache_stats["misses"],
+                        }, step=log_step)
+                        if cache_stats["hit_rate"] < 1.0:
+                            print(
+                                f"[TeacherCache] step={log_step} "
+                                f"hit_rate={cache_stats['hit_rate']:.4f} "
+                                f"({cache_stats['hits']}/{cache_stats['total']}, "
+                                f"miss={cache_stats['misses']})"
+                            )
+
+            # Learning rate warmup
+            if cfg.lr_warmup_steps > 0:
+                lr_progress = min((gradient_step_idx + 1) / cfg.lr_warmup_steps, 1.0)
+                current_lr = original_lr * (0.1 + 0.9 * lr_progress)
+                for param_group in optimizer.param_groups:
+                    param_group["lr"] = current_lr
+
+            if distributed_state.is_main_process and gradient_step_idx % cfg.wandb_log_freq == 0:
+                wandb.log(
+                    {"VLA Train/Learning Rate": scheduler.get_last_lr()[0]},
+                    step=log_step,
+                )
+
+            # Optimizer step
+            if (batch_idx + 1) % cfg.grad_accumulation_steps == 0:
+                optimizer.step()
+                scheduler.step()
+                optimizer.zero_grad()
+                progress.update()
+
+            # Save model checkpoint
+            if gradient_step_idx > 0 and log_step % cfg.save_freq == 0:
+                save_training_checkpoint(
+                    cfg=cfg,
+                    run_dir=run_dir,
+                    log_step=log_step,
+                    vla=vla,
+                    processor=processor,
+                    proprio_projector=proprio_projector if cfg.use_proprio else None,
+                    noisy_action_projector=noisy_action_projector if cfg.use_diffusion else None,
+                    action_head=action_head if (cfg.use_l1_regression or cfg.use_diffusion) else None,
+                    train_dataset=train_dataset,
+                    distributed_state=distributed_state,
+                    gating_network=gating_network,
+                    is_phase2=phase2_started,
+                    final_p_keep=final_p_keep,
+                )
+
+            # Stop training when max_steps is reached
+            if log_step == cfg.max_steps:
+                print(f"Max step {cfg.max_steps} reached! Stopping training...")
+                break
+
+
+if __name__ == "__main__":
+    finetune()
